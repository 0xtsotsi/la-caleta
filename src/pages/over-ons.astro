---
import { Image } from 'astro:assets';
import award from '../assets/images/award-gouden-knip.jpg';
import interieur from '../assets/images/interieur-2.jpg';
import puerta from '../assets/images/stock-puerta-caleta.jpg';
import team from '../assets/images/team-2018.jpg';
import PageHero from '../components/PageHero.astro';
import { facts } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const timeline = [
  {
    when: `De eerste ${facts.yearsBeforeHandover} jaar`,
    title: 'Een Spaans restaurant aan het Raadhuisplein',
    body: 'Vader bouwt La Caleta op: tapas aan de bar en aan tafel, vlees en vis van de grill, en een team dat blijft.',
  },
  {
    when: String(facts.award.year),
    title: facts.award.title,
    body: facts.award.detail,
  },
  {
    when: String(facts.handover),
    title: 'Van vader op dochter',
    body: 'De dochter neemt het restaurant over. Ze doen het nog altijd samen, met hetzelfde team.',
  },
];

const values = [
  {
    title: 'Rundvlees op +1 graad',
    body: 'Het rundvlees komt vers uit Zuid-Amerika, van 100 procent biologische runderen die in de vrije natuur leven. Mals, met weinig vet.',
  },
  {
    title: 'Alles in olijfolie',
    body: 'Al onze gerechten worden in olijfolie bereid. De carpaccio maken we zelf, van ons eigen vlees.',
  },
  {
    title: 'Voor iedereen een bord',
    body: 'Vegetarisch, een allergie of een speciaal dieet: zeg het, dan zoeken we samen gerechten die u wel mag eten.',
  },
];
---

<BaseLayout
  title="Over ons"
  description="La Caleta in Rozenburg: na 17 jaar overgegaan van vader op dochter. Rundvlees uit Zuid-Amerika, alles in olijfolie en winnaar van de Verkiezing Leukste Restaurant 2018."
>
  <PageHero
    label="Over ons"
    title="Van vader"
    titleItalic="op dochter"
    intro={`${facts.yearsBeforeHandover} jaar lang stond vader in de keuken aan het Raadhuisplein. In ${facts.handover} nam zijn dochter het over. Het team bleef, de keuken ook.`}
    image={puerta}
    imageAlt="De Puerta de La Caleta in Cádiz: een witte poort met een stenen boog"
  />

  <section class="section" aria-labelledby="tijdlijn-title">
    <div class="shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <h2 id="tijdlijn-title" class="display-l text-tinta">Hoe het ging</h2>
        <div class="zoom-frame mt-10 hidden aspect-[16/9] max-w-md lg:block">
          <Image src={interieur} alt="De eetzaal van La Caleta met gedekte tafels" widths={[480, 800]} sizes="28rem" class="h-full w-full object-cover" />
        </div>
      </div>
      <ol class="border-l border-tinta/20">
        {
          timeline.map((item) => (
            <li class="relative pb-10 pl-8 last:pb-0">
              <span class="absolute top-2.5 -left-[5px] h-2.5 w-2.5 rounded-full bg-terracota" aria-hidden="true" />
              <p class="label text-terracota">{item.when}</p>
              <h3 class="mt-2 font-display text-[1.75rem] leading-tight text-tinta">{item.title}</h3>
              <p class="mt-2 max-w-lg text-tinta-2">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="on-dark glow-host section" aria-labelledby="keuken-title">
    <div class="glow" data-glow aria-hidden="true"></div>
    <div class="shell">
      <h2 id="keuken-title" class="display-l max-w-2xl text-crema">Waar de keuken op let</h2>
      <dl class="mt-12 grid gap-10 md:grid-cols-3 md:gap-12">
        {
          values.map((value) => (
            <div class="border-t border-crema/20 pt-6">
              <dt class="font-display text-[1.75rem] leading-tight text-crema">{value.title}</dt>
              <dd class="mt-3 text-crema-2">{value.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="award-title">
    <div class="shell grid items-center gap-12 md:grid-cols-2 md:gap-20">
      <div class="grid grid-cols-[0.8fr_1fr] items-end gap-4">
        <Image src={award} alt={`Oorkonde: ${facts.award.title}, winnaar gemeente Rotterdam en Gold Award, La Caleta`} widths={[320, 640]} sizes="(min-width: 768px) 18vw, 40vw" class="w-full border border-tinta/15" />
        <Image src={team} alt="Het team van La Caleta bij de verkiezing in 2018" widths={[400, 800]} sizes="(min-width: 768px) 22vw, 50vw" class="aspect-[4/3] w-full object-cover" />
      </div>
      <div>
        <p class="label text-terracota">{facts.award.year}</p>
        <h2 id="award-title" class="display-l mt-3 text-tinta">Leukste restaurant van de gemeente Rotterdam</h2>
        <p class="lede mt-5 text-tinta-2">
          Bij de {facts.award.title} won La Caleta de hoogste waardering in de gemeente Rotterdam, en
          de Gold Award.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="langs-title">
    <div class="shell flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
      <h2 id="langs-title" class="display-l max-w-xl text-tinta">Kom proeven</h2>
      <div class="flex flex-wrap gap-3">
        <a href={withBase('/reserveren/')} class="btn btn-reserve">Reserveer een tafel</a>
        <a href={withBase('/menu/')} class="btn btn-line">Bekijk de kaart</a>
      </div>
    </div>
  </section>
</BaseLayout>
