---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import DishList from '../components/DishList.astro';

import heroImage from '../assets/images/tapas-bord.jpg';
import keukenTapas from '../assets/images/sfeer-gasten.jpg';
import tapasTafel from '../assets/images/tapas-tafel.jpg';
import tapasKaart1 from '../assets/images/tapas-kaart-1.jpg';
import tapasKaart2 from '../assets/images/tapas-kaart-2.jpg';

import { tapasCold, tapasWarm } from '../data/site';
import { withBase } from '../lib/urls';

const sangria = [
  { name: 'Karaf (1 liter)', price: '€29' },
  { name: 'Sangria rood', price: '€6,50' },
  { name: 'Sangria wit', price: '€6,50' },
];

const regels = [
  'Reserveren aanbevolen ivm voorgereiden',
  'Inloop tussen 17:00 en 20:00 uur, ipv. het sluiten van onze warme keuken om 21:30 uur',
  'Maximaal 2 tapas p.p. per ronde',
  'Desserts niet inbegrepen',
  'Drank niet inbegrepen',
  'Wij serveren geen kraanwater',
  'Bij teveel bestelde tapas brengen wij 2,50 per tapa in rekening',
  'Alle gerechten worden geserveerd met brood',
];
---

<BaseLayout
  title="Tapas"
  description="Spaanse tapas bij Restaurant La Caleta in Rozenburg. Elke woensdag en donderdag een tapasdag, met koude en warme tapas, huisgemaakte sangria en Spaanse wijnen."
>
  <PageHero
    eyebrow="La Caleta · Tapas"
    title="Tapas, zoals het hoort"
    intro="In Spanje eet je tapas met een drankje aan de bar. Bij La Caleta serveren wij onze tapas ook bij de lunch en bij het diner — of wij brengen ze naar uw tafel."
    image={heroImage}
    imageAlt="Tapas op een houten tafel"
  />

  <!-- Tapas dag -->
  <section id="tapasdag" class="bg-rojo kaarslicht py-16 text-crema md:py-24">
    <div class="shell grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-20">
      <div>
        <p class="font-script text-3xl text-crema/85">Tapas dag</p>
        <h2 class="mt-3 font-display text-4xl leading-[1.05] font-medium md:text-6xl">
          Elke woensdag & donderdag
        </h2>
        <p class="mt-5 max-w-lg text-crema/80">
          Een tafel vol Spaanse gerechten om samen te delen. Je eet zo veel je wilt, want bij de
          tapasdag betaal je een vast bedrag per persoon. Onze huisgemaakte sangria en Spaanse wijnen
          gaan er los bij.
        </p>
        <p class="mt-8 font-display text-6xl leading-none font-medium">€34,50 <span class="text-2xl">p.p.</span></p>
        <a href={withBase('/contact/#reserveren')} class="btn mt-8 bg-crema text-rojo hover:bg-crema-oscuro">
          Reserveer voor de tapasdag
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <Image
          src={tapasTafel}
          alt="Tapas op tafel bij kaarslicht"
          class="aspect-square w-full object-cover"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 20vw, 45vw"
          loading="lazy"
        />
        <Image
          src={keukenTapas}
          alt="Bediening in de warme sfeer van La Caleta"
          class="aspect-square w-full object-cover"
          widths={[320, 640]}
          sizes="(min-width: 1024px) 20vw, 45vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Koude en warme tapas -->
  <section id="tapaslijst" class="paper py-20 md:py-28">
    <div class="shell">
      <SectionTitle
        script="para compartir"
        eyebrow="Kies je favorieten"
        title="Tapas frias & tapas calientes"
        intro="Kies zelf wat je aan de bar of aan tafel wilt bestellen. Alles wordt vers bereid en met brood geserveerd."
      />

      <div class="mt-14 grid gap-x-16 gap-y-14 lg:grid-cols-[1fr_1.7fr]">
        <div>
          <h3 class="font-display text-3xl font-medium text-rojo">Tapas frías</h3>
          <p class="mb-6 mt-1 text-sm text-tinta/50">Koude tapas</p>
          <DishList dishes={tapasCold} showTags />
        </div>
        <div>
          <h3 class="font-display text-3xl font-medium text-rojo">Tapas calientes</h3>
          <p class="mb-6 mt-1 text-sm text-tinta/50">Warme tapas</p>
          <div class="lg:columns-2 lg:gap-12">
            <DishList dishes={tapasWarm} showTags />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tapas kaarten -->
  <section id="tapaskaarten" class="bg-carbon kaarslicht py-20 text-crema md:py-24">
    <div class="shell">
      <SectionTitle
        script="la carta"
        eyebrow="Tapas kaart"
        title="Bekijk onze tapas kaarten"
        tone="light"
      />

      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {
          [tapasKaart1, tapasKaart2].map((kaart) => (
            <Image
              src={kaart}
              alt="Tapas kaart van Restaurant La Caleta"
              class="w-full shadow-2xl shadow-black/40"
              widths={[480, 575]}
              sizes="(min-width: 768px) 45vw, 90vw"
              loading="eager"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Sangria & regels -->
  <section id="sangria" class="bg-crema-oscuro py-20 md:py-28">
    <div class="shell grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionTitle
          script="sangría"
          eyebrow="Huisgemaakt"
          title="Sangria, zoals in Spanje"
          intro="Wij maken onze sangria zelf, met Spaanse wijn en fruit. Kies rood of wit — of neem een karaf van een liter om mee te nemen."
        />

        <div class="mt-10">
          <DishList dishes={sangria} />
        </div>
      </div>

      <div>
        <h3 class="font-display text-3xl font-medium text-rojo">Regels bij de tapas</h3>
        <p class="mb-6 mt-1 text-sm text-tinta/50">Goed om te weten</p>
        <ul class="space-y-3.5">
          {
            regels.map((regel) => (
              <li class="flex gap-3 text-sm leading-relaxed text-tinta/70">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-rojo" aria-hidden="true" />
                {regel}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm text-tinta/55">
          Wilt u weten wat de voorwaarden zijn? Bel ons gerust via
          <a href="tel:+31181214342" class="link-underline text-rojo">0181 - 214342</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
