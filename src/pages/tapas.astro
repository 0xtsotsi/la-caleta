---
import tapasKaart1 from '../assets/images/tapas-kaart-1.jpg';
import tapasKaart2 from '../assets/images/tapas-kaart-2.jpg';
import sangriaImg from '../assets/images/stock-sangria.jpg';
import tapasCazuelas from '../assets/images/stock-tapas-cazuelas.jpg';
import ArchImage from '../components/ArchImage.astro';
import DishList from '../components/DishList.astro';
import PageHero from '../components/PageHero.astro';
import { facts, ninosTapas, sangria, site, tapasCold, tapasDay, tapasWarm } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Tapas en tapasdag"
  description={`Tapasdag bij La Caleta in Rozenburg: elke woensdag en donderdag ${facts.tapasCount} koude en warme tapas voor ${tapasDay.price} per persoon. Met de regels, het kindermenu en huisgemaakte sangria.`}
>
  <PageHero
    label="Tapas"
    title="Tapas om te delen"
    intro={`Elke dag los te bestellen. Op woensdag en donderdag is het tapasdag: kies uit ${facts.tapasCount} tapas, zo vaak als u wilt, voor ${tapasDay.price} per persoon.`}
    image={tapasCazuelas}
    imageAlt="Tapas in terracotta schaaltjes op een houten tafel"
  >
    <a href={withBase('/reserveren/')} class="btn btn-reserve mt-8">Reserveer voor tapasdag</a>
  </PageHero>

  <section class="section bg-arena" aria-labelledby="regels-title">
    <div class="shell grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <div>
        <p class="label text-terracota">{tapasDay.days}</p>
        <h2 id="regels-title" class="display-l mt-3 text-tinta">Zo werkt tapasdag</h2>
        <p class="mt-6 flex items-baseline gap-3">
          <span class="font-display text-[clamp(3.5rem,7vw,5.5rem)] leading-none text-terracota">{tapasDay.price}</span>
          <span class="text-tinta-2">per persoon</span>
        </p>
        <p class="mt-4 text-tinta-2">Kleine eter? Dan stelt u zelf uw tapas samen van de losse kaart.</p>
      </div>
      <ol class="space-y-0 text-tinta">
        {
          tapasDay.rules.map((rule) => (
            <li class="border-b border-tinta/15 py-3.5">{rule}</li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="alle-tapas-title">
    <div class="shell">
      <h2 id="alle-tapas-title" class="display-l max-w-2xl text-tinta">De {facts.tapasCount} tapas van tapasdag</h2>
      <p class="lede mt-5 max-w-2xl text-tinta-2">Met het nummer bestelt u makkelijk bij de bediening. Alles komt met brood.</p>
      <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
        <div>
          <h3 class="font-display text-[1.75rem] text-tinta">Koud <span class="italic text-tinta-2" lang="es">tapas frías</span></h3>
          <div class="mt-3"><DishList dishes={tapasCold} start={1} /></div>
        </div>
        <div>
          <h3 class="font-display text-[1.75rem] text-tinta">Warm <span class="italic text-tinta-2" lang="es">tapas calientes</span></h3>
          <div class="mt-3"><DishList dishes={tapasWarm} start={tapasCold.length + 1} columns={2} /></div>
        </div>
      </div>
      <p class="mt-10 text-[0.9375rem] text-tinta-2">
        Allergie? Meld het ons, dan helpen we u graag. Losse tapas met prijzen staan op de{' '}
        <a href={withBase('/menu/#tapas')} class="link-text text-terracota">menukaart</a>.
      </p>
    </div>
  </section>

  <section class="on-dark glow-host section" aria-labelledby="ninos-title">
    <div class="glow" data-glow aria-hidden="true"></div>
    <div class="shell grid gap-12 md:grid-cols-2 md:gap-20">
      <div>
        <p class="label text-cobre">Op tapasdag, {ninosTapas.age}</p>
        <h2 id="ninos-title" class="display-l mt-3 text-crema" lang="es">Niños</h2>
        <p class="mt-6 flex items-baseline gap-3">
          <span class="font-display text-[clamp(3rem,6vw,4.5rem)] leading-none text-cobre">{ninosTapas.price}</span>
          <span class="text-crema-2">per kind</span>
        </p>
      </div>
      <div>
        <p class="text-crema-2">Onder andere:</p>
        <ul class="mt-3">
          {ninosTapas.items.map((item) => <li class="border-b border-crema/15 py-3 text-crema">{item}</li>)}
        </ul>
        <p class="mt-6 text-[0.9375rem] text-crema-2">
          Op de andere dagen is er een{' '}
          <a href={withBase('/menu/#kinderen')} class="link-text text-crema">kindermenu tot en met 12 jaar</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sangria-title">
    <div class="shell grid items-center gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-20">
      <ArchImage image={sangriaImg} alt="Een glas witte sangria met aardbei en sinaasappel" sizes="(min-width: 768px) 32vw, 80vw" class="mx-auto w-full max-w-sm" />
      <div>
        <h2 id="sangria-title" class="display-l text-tinta">Huisgemaakte sangria</h2>
        <p class="lede mt-5 text-tinta-2">Rood of wit, fris en fruitig. Ook in een fles om mee naar huis te nemen.</p>
        <div class="mt-6"><DishList dishes={sangria} /></div>
      </div>
    </div>
  </section>

  <section class="section bg-arena" aria-labelledby="tapaskaart-title">
    <div class="shell">
      <h2 id="tapaskaart-title" class="display-m text-tinta">De tapaskaart op papier</h2>
      <ul class="mt-8 grid max-w-2xl grid-cols-2 gap-5">
        {
          [
            { image: tapasKaart1, label: 'Tapasdag: koude en warme tapas' },
            { image: tapasKaart2, label: 'Sangria, regels en kindermenu' },
          ].map((kaart) => (
            <li>
              <a href={kaart.image.src} target="_blank" rel="noopener" class="group block">
                <img src={kaart.image.src} width={kaart.image.width} height={kaart.image.height} alt="" loading="lazy" class="w-full border border-tinta/15" />
                <span class="mt-2 block text-[0.9375rem] text-tinta group-hover:underline">
                  {kaart.label}<span class="sr-only"> (opent in een nieuw venster)</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-[0.9375rem] text-tinta-2">
        Vragen over tapasdag? Bel <a href={site.phoneHref} class="link-text text-terracota">{site.phone}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
