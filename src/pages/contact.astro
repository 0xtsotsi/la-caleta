---
import exterieur from '../assets/images/exterieur.jpg';
import Icon from '../components/Icon.astro';
import OpeningHours from '../components/OpeningHours.astro';
import PageHero from '../components/PageHero.astro';
import { reservation, site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Contact en route"
  description="Restaurant La Caleta, Raadhuisplein 4a, 3181 CG Rozenburg. Bel 0181 - 214342 of mail info@lacaleta.nl. Gratis parkeren in de buurt."
>
  <PageHero
    label="Contact"
    title={site.address.street}
    titleItalic={`in ${site.address.city}`}
    intro="Bel, mail of loop binnen. Parkeren is gratis, in de directe omgeving."
    image={exterieur}
    imageAlt="De gevel van Restaurant La Caleta aan het Raadhuisplein"
  />

  <section class="section" aria-labelledby="gegevens-title">
    <div class="shell grid gap-14 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <h2 id="gegevens-title" class="sr-only">Contactgegevens</h2>
        <dl class="divide-y divide-tinta/15 border-y border-tinta/15">
          <div class="py-5">
            <dt class="text-tinta-2">Telefoon, ook voor reserveren</dt>
            <dd class="mt-1">
              <a href={site.phoneHref} class="link-u font-display text-[2rem] leading-tight text-tinta">{site.phone}</a>
            </dd>
          </div>
          <div class="py-5">
            <dt class="text-tinta-2">E-mail</dt>
            <dd class="mt-1">
              <a href={`mailto:${site.email}`} class="link-u font-display text-[2rem] leading-tight text-tinta">{site.email}</a>
            </dd>
          </div>
          <div class="py-5">
            <dt class="text-tinta-2">Adres</dt>
            <dd class="mt-1 text-tinta">
              <address class="not-italic">
                {site.legalName}<br />{site.address.street}<br />{site.address.postalCode} {site.address.city}
              </address>
            </dd>
          </div>
          <div class="flex items-start gap-3 py-5">
            <Icon name="car" class="mt-1 text-terracota" />
            <div>
              <dt class="font-medium text-tinta">Gratis parkeren</dt>
              <dd class="text-tinta-2">In de directe omgeving van het restaurant.</dd>
            </div>
          </div>
          <div class="flex items-start gap-3 py-5">
            <Icon name="gift" class="mt-1 text-terracota" />
            <div>
              <dt class="font-medium text-tinta">VVV-cadeaukaart</dt>
              <dd class="text-tinta-2">Welkom bij het afrekenen. We hebben ook een eigen cadeaubon.</dd>
            </div>
          </div>
        </dl>

        <h2 class="mt-12 font-display text-[1.75rem] text-tinta">Openingstijden</h2>
        <div class="mt-3 max-w-md"><OpeningHours /></div>
        <p class="mt-3 text-[0.9375rem] text-tinta-2">De warme keuken sluit om {reservation.kitchenCloses}.</p>
      </div>

      <div>
        <div class="border border-tinta/15">
          <iframe
            title="Kaart met de ligging van Restaurant La Caleta (OpenStreetMap)"
            src={site.mapEmbedUrl}
            class="block h-[22rem] w-full border-0 md:h-[30rem]"
            loading="eager"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <a href={site.mapsHref} target="_blank" rel="noopener noreferrer" class="link-u mt-4 inline-flex items-center gap-2 text-tinta">
          Route plannen in Google Maps <Icon name="arrow-up-right" size={16} />
          <span class="sr-only">(opent in een nieuw venster)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="on-dark glow-host section" aria-labelledby="online-title">
    <div class="glow" data-glow aria-hidden="true"></div>
    <div class="shell flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <h2 id="online-title" class="display-l text-crema">Liever online reserveren?</h2>
        <p class="lede mt-4 text-crema-2">Kies een datum, tijd en het aantal personen.</p>
      </div>
      <a href={withBase('/reserveren/')} class="btn btn-reserve">Naar het reserveringsformulier</a>
    </div>
  </section>
</BaseLayout>
