---
import tapasBordWarm from '../assets/images/tapas-bord-warm.jpg';
import PageHero from '../components/PageHero.astro';
import { facts, seniorMenu, services, site, tapasDay, twaalfUurtje } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const offers = [
  {
    id: 'tapasdag',
    when: tapasDay.days,
    title: 'Tapasdag',
    price: tapasDay.price,
    unit: 'per persoon',
    body: `Kies uit ${facts.tapasCount} koude en warme tapas, twee per persoon per ronde, zo vaak als u wilt. Inloop tussen ${tapasDay.walkIn.from} en ${tapasDay.walkIn.until}.`,
    link: { href: '/tapas/', label: 'De tapas en de regels' },
  },
  {
    id: 'senioren',
    when: 'Driegangenmenu',
    title: 'Seniorenmenu',
    price: seniorMenu.price,
    unit: 'per persoon',
    body: seniorMenu.note,
    courses: seniorMenu.courses,
  },
  {
    id: 'twaalf-uurtje',
    when: 'Bij de lunch, vanaf 11:00',
    title: '12-uurtje',
    price: twaalfUurtje.price,
    unit: 'per persoon',
    body: twaalfUurtje.body,
    link: { href: '/menu/#lunch', label: 'De hele lunchkaart' },
  },
];
---

<BaseLayout
  title="Acties"
  description="Acties bij La Caleta in Rozenburg: tapasdag op woensdag en donderdag, het seniorenmenu, het 12-uurtje, groepen, afhuren en cadeaubonnen. VVV-cadeaukaart welkom."
>
  <PageHero
    label="Acties"
    title="Voordelig aan tafel"
    intro="Tapasdag, het seniorenmenu en het 12-uurtje. En voor groepen, een feest of een cadeau denken we graag mee."
    image={tapasBordWarm}
    imageAlt="Een houten plank met warme tapas"
  />

  <section class="section" aria-labelledby="aanbod-title">
    <div class="shell">
      <h2 id="aanbod-title" class="sr-only">Het aanbod</h2>
      <ol class="border-t border-tinta/20">
        {
          offers.map((offer) => (
            <li id={offer.id} class="grid gap-6 border-b border-tinta/20 py-10 md:grid-cols-[1fr_1.4fr_auto] md:gap-12 md:py-12">
              <div>
                <p class="label text-terracota">{offer.when}</p>
                <h3 class="display-m mt-2 text-tinta">{offer.title}</h3>
              </div>
              <div class="min-w-0 text-tinta-2">
                {offer.courses && (
                  <dl class="mb-4 grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5">
                    {offer.courses.map((course) => (
                      <>
                        <dt class="font-medium text-tinta">{course.label}</dt>
                        <dd>{course.value}</dd>
                      </>
                    ))}
                  </dl>
                )}
                <p>{offer.body}</p>
                {offer.link && (
                  <a href={withBase(offer.link.href)} class="link-u mt-4 inline-block text-tinta">
                    {offer.link.label}
                  </a>
                )}
              </div>
              <div class="flex flex-row flex-wrap items-baseline gap-3 md:flex-col md:items-end md:gap-1">
                <span class="font-display text-[3rem] leading-none text-terracota">{offer.price}</span>
                <span class="text-[0.9375rem] text-tinta-2">{offer.unit}</span>
                <a href={withBase('/reserveren/')} class="btn btn-reserve ml-auto md:mt-5 md:ml-0">Reserveer</a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="on-dark glow-host section" aria-labelledby="extra-title">
    <div class="glow" data-glow aria-hidden="true"></div>
    <div class="shell">
      <h2 id="extra-title" class="display-l max-w-2xl text-crema">Groepen, feesten en cadeaus</h2>
      <dl class="mt-12 grid gap-x-16 gap-y-10 md:grid-cols-2">
        {
          services.map((service) => (
            <div id={service.id} class="border-t border-crema/20 pt-6">
              <dt class="font-display text-[1.75rem] leading-tight text-crema">{service.title}</dt>
              <dd class="mt-3 max-w-md text-crema-2">{service.body}</dd>
            </div>
          ))
        }
      </dl>
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={site.phoneHref} class="btn btn-line">Bel {site.phone}</a>
        <a href={`mailto:${site.email}`} class="link-u text-crema">Of mail {site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
