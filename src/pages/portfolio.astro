---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Icon from '../components/Icon.astro';
import {
  carousel,
  cover,
  planning,
  planningNotes,
  posts,
  profile,
  stories,
  teBevestigenSocial,
} from '../data/portfolio';
import BaseLayout from '../layouts/BaseLayout.astro';

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*.jpg', {
  eager: true,
});
const img = (file: string): ImageMetadata => {
  const found = modules[`../assets/portfolio/${file}.jpg`];
  if (!found) throw new Error(`Beeld ontbreekt: ${file}`);
  return found.default;
};

type Item = {
  id: string;
  title: string;
  kind: string;
  alt: string;
  caption: string;
  src: string;
  download: string;
  size: string;
};
const items: Item[] = [];
const add = async (file: string, title: string, kind: string, alt: string, caption: string) => {
  const meta = img(file);
  const view = await getImage({ src: meta, width: meta.width, format: 'webp', quality: 88 });
  const download = await getImage({ src: meta, format: 'jpg', quality: 95 });
  items.push({
    id: file,
    title,
    kind,
    alt,
    caption,
    src: view.src,
    download: download.src,
    size: `${meta.width} × ${meta.height}`,
  });
};

await add(cover.file, cover.title, 'Cover', cover.alt, 'Voorblad van de presentatie.');
for (const post of posts) {
  await add(
    post.file,
    post.title,
    `Post, ${post.type.toLowerCase()}`,
    post.alt,
    `${post.caption} ${post.cta}`,
  );
}
for (let i = 0; i < carousel.alt.length; i++) {
  await add(
    `carrousel-0${i + 1}`,
    `Carrousel, dia ${i + 1} van ${carousel.alt.length}`,
    'Carrousel',
    carousel.alt[i],
    `${carousel.caption} ${carousel.cta}`,
  );
}
for (const story of stories) {
  await add(
    story.file,
    story.title,
    'Story',
    story.alt,
    `${story.wanneer}. ${story.actie}.`,
  );
}

// Oklch uit global.css omgerekend naar hex, zodat de kleuren in de presentatie dezelfde zijn.
const toHex = (L: number, C: number, hue: number) => {
  const a = C * Math.cos((hue * Math.PI) / 180);
  const b = C * Math.sin((hue * Math.PI) / 180);
  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
  const lin = [
    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
  ];
  return `#${lin
    .map((v) => {
      const g = v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055;
      return Math.round(Math.min(1, Math.max(0, g)) * 255)
        .toString(16)
        .padStart(2, '0');
    })
    .join('')}`;
};
const palette = [
  { name: 'Espresso', token: 'espresso', o: [0.2, 0.018, 50], rol: 'Donkere vlakken en de achtergrond van de hero' },
  { name: 'Crema', token: 'crema', o: [0.968, 0.014, 85], rol: 'Lichte vlakken en tekst op donker' },
  { name: 'Arena', token: 'arena', o: [0.925, 0.028, 78], rol: 'Tweede lichte ondergrond, voor aanbiedingen' },
  { name: 'Terracota', token: 'terracota', o: [0.5, 0.13, 40], rol: 'Prijzen, nummers en accenten op licht' },
  { name: 'Cobre', token: 'cobre', o: [0.76, 0.1, 62], rol: 'Labels, accenten en de rand om de boog op donker' },
  { name: 'Rojo', token: 'rojo', o: [0.47, 0.17, 27], rol: 'Alleen de reserveerknop' },
].map((c) => ({
  ...c,
  hex: toHex(c.o[0], c.o[1], c.o[2]),
  oklch: `oklch(${c.o[0]} ${c.o[1]} ${c.o[2]})`,
}));

const sizes = '(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw';
const kanaalLabel = { Feed: 'Feed', Carrousel: 'Carrousel', Story: 'Story' } as const;
---

<BaseLayout
  title="Social media portfolio"
  description="Voorstel voor de Instagram van Restaurant La Caleta: feed, posts, carrousel, stories en contentplanning in de huisstijl van de website."
  bare
>
  <header class="pf-bar on-dark">
    <div class="shell flex items-center justify-between gap-4 py-3">
      <a href="#begin" class="font-script text-[1.9rem] leading-none text-crema">La Caleta</a>
      <nav aria-label="Onderdelen" class="pf-nav hidden md:block">
        <ul class="flex gap-6 text-[0.9375rem] text-crema-2">
          <li><a href="#identiteit" class="pf-link">Identiteit</a></li>
          <li><a href="#feed" class="pf-link">Feed</a></li>
          <li><a href="#posts" class="pf-link">Posts</a></li>
          <li><a href="#carrousel" class="pf-link">Carrousel</a></li>
          <li><a href="#stories" class="pf-link">Stories</a></li>
          <li><a href="#planning" class="pf-link">Planning</a></li>
        </ul>
      </nav>
      <button type="button" class="btn btn-reserve" data-present>Start presentatie</button>
    </div>
  </header>

  <section id="begin" class="on-dark glow-host" aria-labelledby="pf-title">
    <span class="glow" data-glow aria-hidden="true"></span>
    <div class="shell pb-16 pt-16 md:pt-24">
      <p class="label text-cobre">Social media portfolio · WebRnds</p>
      <h1 id="pf-title" class="display-xl mt-5 text-crema">
        Instagram die klinkt<br /><span class="italic text-cobre">als de website</span>
      </h1>
      <p class="lede mt-6 max-w-xl text-crema-2">
        Negen posts, een carrousel, zes stories en een planning voor de eerste maand, ontworpen in
        het ontwerpsysteem van de nieuwe website van Restaurant La Caleta.
      </p>
      <dl class="mt-10 grid max-w-3xl grid-cols-2 gap-6 border-t border-crema/15 pt-6 sm:grid-cols-4">
        <div><dt class="text-crema-2">Posts</dt><dd class="display-m text-crema">9</dd></div>
        <div><dt class="text-crema-2">Carrousel</dt><dd class="display-m text-crema">6 dia’s</dd></div>
        <div><dt class="text-crema-2">Stories</dt><dd class="display-m text-crema">6</dd></div>
        <div><dt class="text-crema-2">Planning</dt><dd class="display-m whitespace-nowrap text-crema">4 weken</dd></div>
      </dl>
      <button
        type="button"
        class="pf-open mt-12 block w-full"
        data-open={cover.file}
        aria-label="Bekijk de cover op groot formaat"
      >
        <Image
          src={img(cover.file)}
          alt={cover.alt}
          widths={[720, 1080, 1440, 1920]}
          sizes="(min-width: 1280px) 1216px, 92vw"
          loading="eager"
          class="w-full"
        />
      </button>
    </div>
  </section>

  <div class="azulejo" aria-hidden="true"></div>

  <section id="identiteit" class="section bg-crema" aria-labelledby="identiteit-title">
    <div class="shell">
      <h2 id="identiteit-title" class="display-l text-tinta">
        Eén merk, <span class="italic text-terracota">website en feed</span>
      </h2>
      <p class="lede mt-5 max-w-2xl text-tinta-2">
        De posts gebruiken dezelfde kleuren, letters, bogen en fotografie als de website. Links de
        hero van de site, rechts de eerste post van de feed.
      </p>

      <div class="mt-12 grid items-end gap-6 lg:grid-cols-[1.5fr_0.62fr]">
        <figure>
          <Image
            src={img('ref-website-hero')}
            alt="De hero van de website: Cocina de España en tu mesa, met een boog met een glas wijn"
            widths={[720, 1080, 1440]}
            sizes="(min-width: 1024px) 700px, 92vw"
            class="w-full"
          />
          <figcaption class="label mt-3 text-terracota">De website</figcaption>
        </figure>
        <figure>
          <Image
            src={img('post-01-welkom')}
            alt="De eerste post van de feed, in dezelfde opmaak als de hero van de website"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 360px, 70vw"
            class="mx-auto w-full max-w-[22rem] lg:max-w-none"
          />
          <figcaption class="label mt-3 text-terracota">Instagram</figcaption>
        </figure>
      </div>

      <h3 class="display-m mt-20 text-tinta">Kleuren</h3>
      <ul class="mt-6 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {palette.map((c) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-4">
            <span class="block h-24 border border-tinta/15" style={`background-color: var(--color-${c.token})`}></span>
            <div>
              <p class="font-medium text-tinta">{c.name} <span class="text-tinta-2">{c.hex}</span></p>
              <p class="text-[0.875rem] text-tinta-2">{c.oklch}</p>
              <p class="mt-1 text-[0.9375rem] text-tinta-2">{c.rol}</p>
            </div>
          </li>
        ))}
      </ul>

      <h3 class="display-m mt-20 text-tinta">Letters en vormen</h3>
      <div class="mt-6 grid gap-10 lg:grid-cols-3">
        <div class="border-t border-tinta/20 pt-5">
          <p class="label text-terracota">Koppen, prijzen en nummers</p>
          <p class="display-l mt-3 text-tinta">Cormorant <span class="italic">Garamond</span></p>
          <p class="mt-3 text-tinta-2">Medium en cursief. Het cursieve woord geeft elke kop het accent.</p>
        </div>
        <div class="border-t border-tinta/20 pt-5">
          <p class="label text-terracota">Tekst en labels</p>
          <p class="mt-3 font-medium text-tinta" style="font-size: 2rem; line-height: 1.2">Jost, gewoon en medium</p>
          <p class="mt-3 text-tinta-2">Rustige tekst, labels in kleine hoofdletters met ruime letterafstand.</p>
        </div>
        <div class="border-t border-tinta/20 pt-5">
          <p class="label text-terracota">Alleen het logo</p>
          <p class="font-script mt-3 text-[3rem] leading-none text-tinta">La Caleta</p>
          <p class="mt-3 text-tinta-2">Dancing Script, nergens anders voor gebruikt.</p>
        </div>
      </div>

      <ul class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
        <li class="border-t border-tinta/20 pt-5">
          <span class="arch mb-5 block h-28 w-20 bg-terracota"></span>
          <p class="font-medium text-tinta">De boog</p>
          <p class="mt-1 text-[0.9375rem] text-tinta-2">Halfrond boven, recht onder. Elke foto in een kader gebruikt hem.</p>
        </li>
        <li class="border-t border-tinta/20 pt-5">
          <span class="mb-5 block h-28 w-20 rounded-t-full border border-cobre bg-espresso"></span>
          <p class="font-medium text-tinta">De koperen rand</p>
          <p class="mt-1 text-[0.9375rem] text-tinta-2">Een dunne lijn die een eind verschoven achter de boog loopt.</p>
        </li>
        <li class="border-t border-tinta/20 pt-5">
          <span class="mb-5 flex h-28 flex-col justify-center gap-3 text-[0.9375rem]">
            <span class="flex items-baseline gap-2"><b class="font-medium">Lomo</b><i class="flex-1 border-b border-tinta/30"></i></span>
            <span class="flex items-baseline gap-2"><b class="font-medium text-terracota">01</b> Olijven</span>
          </span>
          <p class="font-medium text-tinta">Stippellijn en nummers</p>
          <p class="mt-1 text-[0.9375rem] text-tinta-2">Zoals de kaart: naam, lijn, waarde. Nummers in terracota.</p>
        </li>
        <li class="border-t border-tinta/20 pt-5">
          <span class="mb-5 block h-28 bg-espresso p-3"><span class="label text-cobre">Label</span><span class="display-m mt-1 block text-crema italic">Kaarslicht</span></span>
          <p class="font-medium text-tinta">Warm en donker</p>
          <p class="mt-1 text-[0.9375rem] text-tinta-2">Kaarslicht, hout en terracotta. Geen koele filters, geen schaduwen op vlakken.</p>
        </li>
      </ul>
    </div>
  </section>

  <section id="feed" class="section on-dark" aria-labelledby="feed-title">
    <div class="shell grid grid-cols-[minmax(0,1fr)] items-center gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
      <div>
        <p class="label text-cobre">De complete feed</p>
        <h2 id="feed-title" class="display-l mt-3 text-crema">
          Negen posts, <span class="italic text-cobre">één geheel</span>
        </h2>
        <p class="lede mt-5 text-crema-2">
          Donker, licht en foto wisselen elkaar af, in een ritme van drie. Elke post heeft een eigen
          karakter en toch zie je meteen dat het La Caleta is.
        </p>
        <ul class="mt-8 grid gap-4 text-crema-2">
          <li class="border-t border-crema/15 pt-4">Rij 1: de intro, een foodfoto en de tapasdag-poster</li>
          <li class="border-t border-crema/15 pt-4">Rij 2: het familieverhaal, de paella en de grill</li>
          <li class="border-t border-crema/15 pt-4">Rij 3: sfeer, collage en reserveren</li>
        </ul>
        <button type="button" class="btn btn-line mt-8" data-present>Bekijk alles op groot formaat</button>
      </div>

      <div class="pf-phone mx-auto" role="group" aria-label="Voorbeeld van het Instagram-profiel">
        <div class="pf-screen">
          <div class="flex items-center gap-4">
            <span class="pf-avatar font-script" aria-hidden="true">LC</span>
            <div>
              <p class="font-medium leading-tight">{profile.handle}</p>
              <p class="text-[0.8125rem] text-crema-2">{profile.category}</p>
            </div>
          </div>
          <p class="mt-3 text-[0.875rem] leading-snug">
            {profile.bio.map((line) => <span class="block">{line}</span>)}
            <span class="block text-cobre">{profile.link}</span>
          </p>
          <div class="mt-3 grid grid-cols-2 gap-2 text-center text-[0.8125rem] font-medium" aria-hidden="true">
            <span class="bg-crema/15 py-1.5">Volgen</span><span class="bg-crema/15 py-1.5">Bericht</span>
          </div>
          <ul class="mt-4 flex gap-3 overflow-hidden" aria-label="Hoogtepunten">
            {profile.highlights.map((h) => (
              <li class="flex w-[3.4rem] flex-none flex-col items-center gap-1 text-center text-[0.625rem] leading-tight">
                <span class="pf-hl display-m" aria-hidden="true">{h[0]}</span>{h}
              </li>
            ))}
          </ul>
          <ul class="mt-4 grid grid-cols-3 gap-px bg-crema/10">
            {posts.map((post) => (
              <li>
                <button type="button" class="pf-open block w-full" data-open={post.file} aria-label={`Bekijk groot: ${post.title}`}>
                  <Image src={img(post.file)} alt={post.alt} widths={[160, 240, 360]} sizes="130px" class="aspect-[4/5] w-full object-cover" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="posts" class="section bg-crema" aria-labelledby="posts-title">
    <div class="shell">
      <p class="label text-terracota">1080 × 1350</p>
      <h2 id="posts-title" class="display-l mt-3 text-tinta">
        De posts, <span class="italic text-terracota">met bijschrift</span>
      </h2>
      <p class="lede mt-5 max-w-2xl text-tinta-2">
        Klik op een beeld voor groot formaat en om te downloaden. Elk bijschrift eindigt met één
        duidelijke oproep.
      </p>
      <ol class="mt-14 grid gap-x-8 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post, i) => (
          <li class="flex flex-col">
            <button type="button" class="pf-open block" data-open={post.file} aria-label={`Bekijk groot: ${post.title}`}>
              <Image src={img(post.file)} alt={post.alt} widths={[360, 540, 720, 1080]} sizes={sizes} class="w-full" />
            </button>
            <p class="label mt-5 text-terracota"><span class="num">0{i + 1}</span> · {post.type}</p>
            <h3 class="display-m mt-2 text-tinta">{post.title}</h3>
            <p class="mt-3 text-[0.9375rem] text-tinta-2"><span class="font-medium text-tinta">Doel.</span> {post.doel}</p>
            <p class="mt-3 text-[0.9375rem] leading-relaxed">{post.caption}</p>
            <p class="mt-3 text-[0.9375rem] font-medium text-terracota">{post.cta}</p>
            <p class="mt-3 text-[0.8125rem] text-tinta-2">{[...post.tags, '#lacaleta', '#rozenburg'].join(' ')}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="carrousel" class="section on-dark" aria-labelledby="carrousel-title">
    <div class="shell">
      <p class="label text-cobre">Carrousel · 6 dia’s</p>
      <h2 id="carrousel-title" class="display-l mt-3 text-crema">
        {carousel.title.split(' tot ')[0]} <span class="italic text-cobre">tot {carousel.title.split(' tot ')[1]}</span>
      </h2>
      <p class="lede mt-5 max-w-2xl text-crema-2">{carousel.doel} De koperen lijn onderaan loopt van dia naar dia door.</p>
    </div>
    <ol class="pf-snap mt-12" aria-label="Dia’s van de carrousel">
      {carousel.alt.map((alt, i) => (
        <li>
          <button type="button" class="pf-open block" data-open={`carrousel-0${i + 1}`} aria-label={`Bekijk groot: dia ${i + 1}`}>
            <Image src={img(`carrousel-0${i + 1}`)} alt={alt} widths={[360, 540, 720]} sizes="(min-width: 640px) 22rem, 72vw" class="w-full" />
          </button>
        </li>
      ))}
    </ol>
    <div class="shell mt-10 max-w-3xl">
      <p class="leading-relaxed text-crema">{carousel.caption}</p>
      <p class="mt-3 font-medium text-cobre">{carousel.cta}</p>
      <p class="mt-3 text-[0.8125rem] text-crema-2">{[...carousel.tags, '#lacaleta', '#rozenburg'].join(' ')}</p>
    </div>
  </section>

  <section id="stories" class="section bg-arena" aria-labelledby="stories-title">
    <div class="shell">
      <p class="label text-terracota">1080 × 1920</p>
      <h2 id="stories-title" class="display-l mt-3 text-tinta">
        Zes stories, <span class="italic text-terracota">in de veilige zone</span>
      </h2>
      <p class="lede mt-5 max-w-2xl text-tinta-2">
        Tekst en knoppen blijven buiten de bovenste 250 en onderste 340 pixels, zodat Instagram ze
        niet bedekt.
      </p>
      <ol class="mt-12 grid grid-cols-2 gap-x-5 gap-y-12 sm:grid-cols-3 xl:grid-cols-6">
        {stories.map((story, i) => (
          <li>
            <button type="button" class="pf-open block w-full" data-open={story.file} aria-label={`Bekijk groot: ${story.title}`}>
              <Image src={img(story.file)} alt={story.alt} widths={[270, 360, 540]} sizes="(min-width: 1280px) 190px, (min-width: 640px) 30vw, 44vw" class="w-full" />
            </button>
            <h3 class="mt-4 font-medium text-tinta"><span class="num text-terracota">0{i + 1}</span> {story.title}</h3>
            <p class="mt-1 text-[0.875rem] text-tinta-2">{story.wanneer}</p>
            <p class="mt-1 text-[0.875rem] text-tinta">{story.actie}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="planning" class="section bg-crema" aria-labelledby="planning-title">
    <div class="shell">
      <p class="label text-terracota">Eerste maand</p>
      <h2 id="planning-title" class="display-l mt-3 text-tinta">
        Vier weken, <span class="italic text-terracota">een vast ritme</span>
      </h2>
      <ul class="mt-8 grid max-w-3xl gap-3 text-tinta-2">
        {planningNotes.map((n) => <li class="border-t border-tinta/15 pt-3">{n}</li>)}
      </ul>
      <ol class="mt-14 grid gap-10 lg:grid-cols-2">
        {planning.map((w) => (
          <li class="border-t-2 border-tinta pt-5">
            <p class="label text-terracota">{w.week}</p>
            <h3 class="display-m mt-1 text-tinta">{w.thema}</h3>
            <p class="mt-2 text-tinta-2">{w.doel}</p>
            <ul class="mt-6">
              {w.slots.map((s) => (
                <li class="grid grid-cols-[3.5rem_1fr] items-center gap-4 border-t border-tinta/15 py-3">
                  {s.file ? (
                    <Image src={img(s.file)} alt="" widths={[112, 168]} sizes="56px" class="aspect-[4/5] w-14 object-cover" />
                  ) : (
                    <span class="aspect-[4/5] w-14 border border-dashed border-tinta/40"></span>
                  )}
                  <p class="text-[0.9375rem]">
                    <span class="label text-terracota">{s.dag} · {kanaalLabel[s.kanaal]}</span><br />
                    <span class="font-medium text-tinta">{s.onderwerp}</span>
                    {s.nieuw && <span class="text-tinta-2"> (nieuw te maken)</span>}
                  </p>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <div class="azulejo" aria-hidden="true"></div>

  <section id="afspraken" class="section on-dark" aria-labelledby="afspraken-title">
    <div class="shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="label text-cobre">Voor de start</p>
        <h2 id="afspraken-title" class="display-l mt-3 text-crema">
          Dit bevestigt <span class="italic text-cobre">de klant</span>
        </h2>
        <a href="#begin" class="btn btn-line mt-8">Terug naar boven</a>
      </div>
      <ul>
        {teBevestigenSocial.map((t) => (
          <li class="grid gap-1 border-t border-crema/15 py-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <p class="font-medium text-crema">{t.punt}</p>
            <p class="text-crema-2">{t.detail}</p>
          </li>
        ))}
      </ul>
