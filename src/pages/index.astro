---
import { Image } from 'astro:assets';
import grillVuur from '../assets/images/grill-vuur.jpg';
import barBediening from '../assets/images/bar-bediening.jpg';
import exterieur from '../assets/images/exterieur.jpg';
import lunchServeren from '../assets/images/lunch-serveren.jpg';
import wijnKaarsen from '../assets/images/sfeer-wijn-kaarsen.jpg';
import tapasCazuelas from '../assets/images/stock-tapas-cazuelas.jpg';
import tapasTabla from '../assets/images/stock-tapas-tabla.jpg';
import spAlcazar from '../assets/images/spanje-alcazar-sevilla.jpg';
import spPatio from '../assets/images/spanje-patio-puerto-real.jpg';
import ArchImage from '../components/ArchImage.astro';
import DishList from '../components/DishList.astro';
import Hero from '../components/Hero.astro';
import Intermezzo from '../components/Intermezzo.astro';
import OpeningHours from '../components/OpeningHours.astro';
import ReserveQuick from '../components/ReserveQuick.astro';
import SpanjeBand from '../components/SpanjeBand.astro';
import StoryScroll, { type Moment } from '../components/StoryScroll.astro';
import {
  desserts,
  facts,
  fish,
  grill,
  paella,
  site,
  starters,
  tapasDay,
  twaalfUurtje,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const moments: Moment[] = [
  {
    label: 'Vanaf 11:00',
    title: 'Lunch',
    body: `Baguettes, tosti's, maaltijdsalades of het 12-uurtje voor ${twaalfUurtje.price}: soep, twee boterhammen, een kroket en een gebakken ei. Brood bruin, wit of glutenvrij.`,
    image: lunchServeren,
    alt: 'Een lunchtafel met kleine schaaltjes, brood en olijven',
    href: '/menu/#lunch',
    cta: 'Naar de lunchkaart',
  },
  {
    label: 'Woensdag en donderdag',
    title: 'Tapas',
    body: `Op tapasdag kiest u uit ${facts.tapasCount} koude en warme tapas, zoveel als u op kunt, voor ${tapasDay.price} per persoon. De andere dagen bestelt u ze los.`,
    image: tapasCazuelas,
    alt: 'Tapas in terracotta schaaltjes op een houten tafel',
    href: '/tapas/',
    cta: 'Bekijk alle tapas',
  },
  {
    label: 'Van de grill',
    title: 'Vlees en vis',
    body: 'Het rundvlees komt vers, op +1 graad, uit Zuid-Amerika en is 100 procent biologisch. Lomo, entrecote, ribeye of T-bone, in olijfolie bereid. Of vis van de plancha.',
    image: grillVuur,
    alt: 'Vlees op een grill boven open vuur',
    href: '/menu/#grill',
    cta: 'Naar de grillkaart',
  },
  {
    label: 'Na het eten',
    title: 'Wijn en sangria',
    body: 'Rioja van Montelciego en Muriel, zoete Moscatel uit Málaga en onze eigen sangria, rood of wit. Een karaf is een liter.',
    image: wijnKaarsen,
    alt: 'Een glas wijn bij kaarslicht',
    href: '/menu/#wijn',
    cta: 'Naar de wijnkaart',
  },
];

const pick = (list: typeof grill, name: string) => list.filter((dish) => dish.name === name);
const featured = [
  ...pick(grill, 'Lomo'),
  ...pick(paella, 'Paella de marisco'),
  ...pick(starters, "Gamba's al ajillo"),
  ...pick(starters, 'Carpaccio La Caleta'),
  ...pick(fish, 'Frito gaditano'),
  ...pick(desserts, 'Leche frita'),
];
---

<BaseLayout>
  <Hero />

  <section class="section" aria-labelledby="welkom-title">
    <div class="shell grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <h2 id="welkom-title" class="display-l text-tinta">
        Onze naam klinkt Spaans. <span class="italic text-terracota">Dat zijn wij ook gewoon.</span>
      </h2>
      <div class="lede space-y-5 text-tinta-2 lg:pt-3">
        <p>
          In {facts.handover} ging La Caleta na {facts.yearsBeforeHandover} jaar over van vader op
          dochter. Het team is gebleven, net als de keuken: alles bereid in olijfolie, en vlees van de
          beste kwaliteit.
        </p>
        <p>
          Vegetarisch eten of een speciaal dieet? Zeg het bij het reserveren, dan zoeken we samen iets
          wat u lekker vindt.
        </p>
        <a href={withBase('/over-ons/')} class="link-u inline-block text-[1rem] text-tinta">Ons verhaal</a>
      </div>
    </div>
  </section>

  <SpanjeBand
    label="Sfeer uit Spanje"
    title="Een beetje zon,"
    titleItalic="een beetje Andalusië"
    items={[
      {
        image: spAlcazar,
        alt: 'Binnenplaats van de Reales Alcázares in Sevilla met bogen en een waterbak',
        line: 'Sol y sombra',
        place: 'Reales Alcázares, Sevilla',
      },
      {
        image: spPatio,
        alt: 'Smal wit steegje met potten vol bloemen in Puerto Real, Spanje',
        line: 'Flores en el patio',
        place: 'Puerto Real, Cádiz',
      },
    ]}
  />

  <StoryScroll moments={moments} title="Van de lunch tot de laatste sangria" />

  <section class="section bg-arena" aria-labelledby="tapasdag-title">
    <div class="shell grid items-center gap-12 md:grid-cols-[0.9fr_1.1fr] md:gap-16">
      <ArchImage
        image={tapasTabla}
        alt="Een plank met tapas: gehaktballetjes, gamba's en olijven"
        sizes="(min-width: 768px) 40vw, 88vw"
        class="order-2 w-full md:order-1"
      />
      <div class="order-1 md:order-2">
        <p class="label text-terracota">{tapasDay.days}</p>
        <h2 id="tapasdag-title" class="display-l mt-3 text-tinta">Tapasdag</h2>
        <p class="mt-6 flex items-baseline gap-3">
          <span class="font-display text-[clamp(3.5rem,7vw,5.5rem)] leading-none text-terracota">{tapasDay.price}</span>
          <span class="text-tinta-2">per persoon</span>
        </p>
        <ul class="mt-8 space-y-2.5 text-tinta-2">
          <li>Kies uit {facts.tapasCount} koude en warme tapas, met brood erbij.</li>
          <li>Twee tapas per persoon per ronde, zo vaak als u wilt.</li>
          <li>Inloop tussen {tapasDay.walkIn.from} en {tapasDay.walkIn.until}. Drank en dessert apart.</li>
        </ul>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={withBase('/reserveren/')} class="btn btn-reserve">Reserveer voor tapasdag</a>
          <a href={withBase('/tapas/')} class="link-u text-tinta">Alle tapas en de regels</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="kaart-title">
    <div class="shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <h2 id="kaart-title" class="display-l text-tinta">Een greep uit de kaart</h2>
        <p class="lede mt-5 text-tinta-2">
          De hele kaart staat online, met prijzen. Paella graag vooraf bestellen.
        </p>
        <a href={withBase('/menu/')} class="btn btn-line mt-8">Bekijk de hele kaart</a>
      </div>
      <DishList dishes={featured} columns={2} />
    </div>
  </section>

  <Intermezzo
    image={barBediening}
    imageAlt="Een Spaanse bar met hammen aan het plafond en wijnflessen in de kast"
    title="Kaarslicht, een glas Rioja en geen haast"
    body="Blijf zitten na het eten. De warme keuken sluit om 21:30, de koffie met een scheut Licor 43 is er daarna nog."
  />

  <section class="section" aria-labelledby="bezoek-title">
    <div class="shell grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
      <div>
        <h2 id="bezoek-title" class="display-l text-tinta">Raadhuisplein 4a</h2>
        <address class="lede mt-5 not-italic text-tinta-2">
          {site.address.postalCode} {site.address.city}. Gratis parkeren in de buurt.
        </address>
        <p class="mt-4 text-tinta-2">
          Op Google {facts.google.rating} uit 5, op basis van {facts.google.reviews} reviews
          (stand {facts.google.date}).
        </p>
        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
          <a href={site.mapsHref} class="link-u text-tinta" target="_blank" rel="noopener noreferrer">
            Route plannen<span class="sr-only"> (opent Google Maps in een nieuw venster)</span>
          </a>
          <a href={site.phoneHref} class="link-u text-tinta">Bel {site.phone}</a>
        </div>
        <div class="zoom-frame mt-10 aspect-[16/9] max-w-md">
          <Image
            src={exterieur}
            alt="De gevel van Restaurant La Caleta aan het Raadhuisplein"
            widths={[480, 800]}
            sizes="(min-width: 1024px) 28rem, 88vw"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
      <div>
        <h3 class="font-display text-[1.75rem] text-tinta">Openingstijden</h3>
        <div class="mt-3"><OpeningHours /></div>
      </div>
    </div>
  </section>

  <section class="on-dark glow-host section" aria-labelledby="reserveer-title">
    <div class="glow" data-glow aria-hidden="true"></div>
    <div class="shell grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-end lg:gap-20">
      <div>
        <h2 id="reserveer-title" class="display-l text-crema">Reserveer een tafel</h2>
        <p class="lede mt-5 text-crema-2">Kies een dag en met hoeveel u komt. De tijd kiest u op de volgende pagina.</p>
      </div>
      <ReserveQuick />
    </div>
  </section>
</BaseLayout>
