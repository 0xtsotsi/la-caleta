---
import { Image } from 'astro:assets';
import menu01 from '../assets/images/menu-kaart-01.jpg';
import menu02 from '../assets/images/menu-kaart-02.jpg';
import menu04 from '../assets/images/menu-kaart-04.jpg';
import menu05 from '../assets/images/menu-kaart-05.jpg';
import menu06 from '../assets/images/menu-kaart-06.jpg';
import menu07 from '../assets/images/menu-kaart-07.jpg';
import menu08 from '../assets/images/menu-kaart-08.jpg';
import menu09 from '../assets/images/menu-kaart-09.jpg';
import menu10 from '../assets/images/menu-kaart-10.jpg';
import menu11 from '../assets/images/menu-kaart-11.jpg';
import menu12 from '../assets/images/menu-kaart-12.jpg';
import menu13 from '../assets/images/menu-kaart-13.jpg';
import menu14 from '../assets/images/menu-kaart-14.jpg';
import lunch12 from '../assets/images/lunch-12uurtje.jpg';
import lunchBaguettes from '../assets/images/lunch-baguettes.jpg';
import lunchSalades from '../assets/images/lunch-salades.jpg';
import churros from '../assets/images/stock-churros.jpg';
import tafelSpaans from '../assets/images/tafel-spaans.jpg';
import ArchImage from '../components/ArchImage.astro';
import DishList from '../components/DishList.astro';
import MenuIndex from '../components/MenuIndex.astro';
import PageHero from '../components/PageHero.astro';
import {
  coffeeNote,
  coffees,
  desserts,
  fish,
  grill,
  lunch,
  mainsNote,
  ninos,
  paella,
  paellaNote,
  salads,
  starters,
  tapasPriced,
  twaalfUurtje,
  wines,
} from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const categories = [
  { id: 'lunch', label: 'Lunch' },
  { id: 'voorgerechten', label: 'Voorgerechten' },
  { id: 'tapas', label: 'Tapas' },
  { id: 'grill', label: 'Van de grill' },
  { id: 'vis', label: 'Vis en vegetarisch' },
  { id: 'paella', label: 'Paella' },
  { id: 'kinderen', label: 'Kindermenu' },
  { id: 'dessert', label: 'Dessert en ijs' },
  { id: 'koffie', label: 'Koffie met' },
  { id: 'wijn', label: 'Wijn en sangria' },
  { id: 'kaarten', label: 'De papieren kaart' },
];

const scans = [
  { image: menu01, label: 'Omslag' },
  { image: menu02, label: 'Welkom' },
  { image: menu04, label: 'Groepen en cadeaubon' },
  { image: menu05, label: 'Voorgerechten' },
  { image: menu06, label: 'Vleesgids' },
  { image: menu07, label: 'Vlees van de grill' },
  { image: menu08, label: 'Vis en vegetarisch' },
  { image: menu09, label: 'Paella en kindermenu' },
  { image: menu10, label: 'Tapas' },
  { image: menu11, label: 'Tapas en regels' },
  { image: menu12, label: 'Dessert en koffie' },
  { image: menu13, label: 'IJs' },
  { image: menu14, label: 'Wijnkaart' },
  { image: lunch12, label: 'Lunch: 12-uurtje' },
  { image: lunchBaguettes, label: 'Lunch: broodjes' },
  { image: lunchSalades, label: 'Lunch: salades' },
];
---

<BaseLayout
  title="Menukaart"
  description="De hele kaart van Restaurant La Caleta in Rozenburg met prijzen: lunch, tapas, vlees van de grill, vis, paella, kindermenu, dessert en Spaanse wijn."
>
  <PageHero
    label="Menukaart"
    title="De hele kaart,"
    titleItalic="met prijzen"
    intro={`Lunch vanaf 11:00 en diner tot de warme keuken sluit om 21:30. ${mainsNote.split('.')[0]}.`}
    image={tafelSpaans}
    imageAlt="Tapas en een glas rode wijn op een houten tafel"
  />

  <div class="section pt-10 md:pt-14">
    <div class="shell grid grid-cols-[minmax(0,1fr)] gap-x-16 lg:grid-cols-[13rem_minmax(0,1fr)]">
      <MenuIndex categories={categories} />

      <div class="min-w-0 space-y-16 md:space-y-20" data-menu-list>
        <section id="lunch" data-menu-section aria-labelledby="h-lunch" class="scroll-mt-36">
          <h2 id="h-lunch" class="display-m text-tinta">Lunch</h2>
          <div class="mt-6 border-l-2 border-terracota pl-5" data-dish data-tags="">
            <p class="dish-row text-[1.125rem]">
              <span class="font-medium">12-uurtje</span>
              <span class="dish-price font-medium text-terracota">{twaalfUurtje.price}</span>
            </p>
            <p class="mt-1 text-tinta-2">{twaalfUurtje.body}</p>
          </div>
          <p class="mt-6 text-[0.9375rem] text-tinta-2">Brood naar keuze: bruin, wit of glutenvrij.</p>
          <div class="mt-4"><DishList dishes={lunch} columns={2} /></div>
          <h3 class="mt-12 font-display text-[1.75rem] text-tinta">Maaltijdsalades en lunchplanken</h3>
          <div class="mt-3"><DishList dishes={salads} columns={2} /></div>
        </section>

        <section id="voorgerechten" data-menu-section aria-labelledby="h-voor" class="scroll-mt-36">
          <h2 id="h-voor" class="display-m text-tinta">Voorgerechten <span class="italic text-tinta-2" lang="es">entremeses</span></h2>
          <div class="mt-6"><DishList dishes={starters} columns={2} /></div>
        </section>

        <section id="tapas" data-menu-section aria-labelledby="h-tapas" class="scroll-mt-36">
          <h2 id="h-tapas" class="display-m text-tinta">Tapas</h2>
          <p class="mt-3 max-w-2xl text-tinta-2">
            Los te bestellen, elke dag. Op woensdag en donderdag is het{' '}
            <a href={withBase('/tapas/')} class="link-text text-terracota">tapasdag</a>: onbeperkt voor €34,50.
          </p>
          <div class="mt-6"><DishList dishes={tapasPriced} columns={2} /></div>
        </section>

        <section id="grill" data-menu-section aria-labelledby="h-grill" class="scroll-mt-36">
          <h2 id="h-grill" class="display-m text-tinta">Van de grill <span class="italic text-tinta-2" lang="es">a la plancha</span></h2>
          <p class="mt-3 max-w-2xl text-tinta-2">{mainsNote}</p>
          <div class="mt-6"><DishList dishes={grill} columns={2} /></div>
        </section>

        <section id="vis" data-menu-section aria-labelledby="h-vis" class="scroll-mt-36">
          <h2 id="h-vis" class="display-m text-tinta">Vis en vegetarisch</h2>
          <div class="mt-6"><DishList dishes={fish} columns={2} /></div>
        </section>

        <section id="paella" data-menu-section aria-labelledby="h-paella" class="scroll-mt-36">
          <h2 id="h-paella" class="display-m text-tinta">Paella</h2>
          <p class="mt-3 max-w-2xl text-tinta-2">{paellaNote} Vanaf €22,50 per persoon.</p>
          <div class="mt-6"><DishList dishes={paella} columns={2} /></div>
        </section>

        <section id="kinderen" data-menu-section aria-labelledby="h-kinderen" class="scroll-mt-36">
          <h2 id="h-kinderen" class="display-m text-tinta">Kindermenu <span class="italic text-tinta-2">tot en met 12 jaar</span></h2>
          <p class="mt-3 max-w-2xl text-tinta-2">
            Liever niet lang wachten? Het kindermenu kan samen met de voorgerechten komen. Zeg het even
            tegen de bediening.
          </p>
          <div class="mt-6"><DishList dishes={ninos} columns={2} /></div>
        </section>

        <section id="dessert" data-menu-section aria-labelledby="h-dessert" class="scroll-mt-36">
          <div class="grid gap-10 md:grid-cols-[1fr_14rem] md:items-start">
            <div>
              <h2 id="h-dessert" class="display-m text-tinta">Dessert en ijs <span class="italic text-tinta-2" lang="es">postres</span></h2>
              <div class="mt-6"><DishList dishes={desserts} showTags={false} /></div>
            </div>
            <ArchImage
              image={churros}
              alt="Churros met suiker en een kopje chocolade"
              sizes="(min-width: 768px) 14rem, 70vw"
              widths={[320, 640]}
              class="mx-auto w-full max-w-[16rem] md:sticky md:top-28"
            />
          </div>
        </section>

        <section id="koffie" data-menu-section aria-labelledby="h-koffie" class="scroll-mt-36">
          <h2 id="h-koffie" class="display-m text-tinta">Koffie met een scheut</h2>
          <p class="mt-3 text-tinta-2">{coffeeNote}</p>
          <div class="mt-6"><DishList dishes={coffees} columns={2} showTags={false} /></div>
        </section>

        <section id="wijn" data-menu-section aria-labelledby="h-wijn" class="scroll-mt-36">
          <h2 id="h-wijn" class="display-m text-tinta">Wijn en sangria</h2>
          <p class="mt-3 text-tinta-2">Per fles, tenzij er een glasprijs bij staat.</p>
          <div class="mt-6"><DishList dishes={wines} columns={2} showTags={false} /></div>
        </section>

        <section id="kaarten" data-menu-section data-menu-static aria-labelledby="h-kaarten" class="scroll-mt-36">
          <h2 id="h-kaarten" class="display-m text-tinta">De papieren kaart</h2>
          <p class="mt-3 max-w-2xl text-tinta-2">
            Zo ligt de kaart in het restaurant op tafel. Klik op een pagina om hem groot te openen.
          </p>
          <ul class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {
              scans.map((scan) => (
                <li>
                  <a href={scan.image.src} class="group block" target="_blank" rel="noopener">
                    <span class="zoom-frame block border border-tinta/15">
                      <Image
                        src={scan.image}
                        alt=""
                        widths={[240, 480]}
                        sizes="(min-width: 1024px) 14vw, 45vw"
                        loading="lazy"
                        class="aspect-[566/800] w-full object-cover"
                      />
                    </span>
                    <span class="mt-2 block text-[0.9375rem] text-tinta group-hover:underline">
                      {scan.label}
                      <span class="sr-only"> (menukaart, opent in een nieuw venster)</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <p class="border-t border-tinta/15 pt-6 text-[0.9375rem] text-tinta-2">
          Allergie of een dieet? Meld het ons, we helpen u graag.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import '../scripts/menu.ts';
</script>
