---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  title: string;
  body?: string;
  position?: string;
}

const { image, imageAlt, title, body, position = 'center' } = Astro.props;
---

<section class="intermezzo on-dark">
  <Image
    src={image}
    alt={imageAlt}
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    loading="lazy"
    class="intermezzo-img"
    style={`object-position: ${position}`}
    data-parallax
  />
  <div class="intermezzo-scrim" aria-hidden="true"></div>
  <div class="shell relative flex min-h-[70svh] items-end py-16 md:py-20">
    <div class="max-w-xl">
      <h2 class="display-l text-crema">{title}</h2>
      {body && <p class="lede mt-5 text-crema-2">{body}</p>}
    </div>
  </div>
</section>

<style>
  .intermezzo {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .intermezzo-img {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }

  .intermezzo-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      oklch(0.2 0.018 50 / 0.95) 0%,
      oklch(0.2 0.018 50 / 0.82) 38%,
      oklch(0.2 0.018 50 / 0.2) 75%,
      oklch(0.2 0.018 50 / 0) 100%
    );
  }
</style>
