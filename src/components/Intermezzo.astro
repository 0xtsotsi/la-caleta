---
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  script?: string;
  title: string;
  quote?: string;
}

const { image, imageAlt, script, title, quote } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-carbon">
  <Image
    src={image}
    alt={imageAlt}
    class="absolute inset-0 -z-10 h-[112%] w-full object-cover"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    quality={82}
    data-parallax
  />
  <div class="absolute inset-0 -z-10 bg-carbon/72"></div>
  <div class="kaarslicht absolute inset-0 -z-10"></div>

  <div class="shell flex min-h-[54svh] flex-col items-center justify-center py-24 text-center">
    {
      script && (
        <p class="font-script text-3xl text-dorado-licht md:text-4xl" data-reveal>
          {script}
        </p>
      )
    }
    <h2
      class="mt-3 max-w-3xl font-display text-4xl leading-[1.05] font-medium text-crema md:text-6xl"
      data-reveal
      data-reveal-delay="90"
    >
      {title}
    </h2>
    {
      quote && (
        <p
          class="mt-6 max-w-2xl text-base leading-relaxed text-crema/75 md:text-lg"
          data-reveal
          data-reveal-delay="160"
        >
          {quote}
        </p>
      )
    }
  </div>
</section>
