---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  /** Tailwind-klasse voor de verhouding, bijvoorbeeld aspect-[4/5]. */
  aspect?: string;
  class?: string;
  /** De boog opent eenmalig als het beeld in beeld komt. */
  reveal?: boolean;
  loading?: 'lazy' | 'eager';
  position?: string;
}

const {
  image,
  alt,
  sizes,
  widths = [480, 800, 1200],
  aspect = 'aspect-[4/5]',
  class: className,
  reveal = true,
  loading = 'lazy',
  position = 'center',
} = Astro.props;
---

<div class:list={['arch', aspect, className]} data-arch-reveal={reveal ? '' : undefined}>
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    class="arch-media"
    style={`object-position: ${position}`}
    data-arch-img
  />
</div>
