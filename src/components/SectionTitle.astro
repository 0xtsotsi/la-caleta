---
interface Props {
  eyebrow?: string;
  script?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
}

const {
  eyebrow,
  script,
  title,
  intro,
  align = 'left',
  tone = 'dark',
} = Astro.props;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center']}>
  {
    script && (
      <p class={`font-script text-3xl md:text-4xl ${tone === 'dark' ? 'text-rojo' : 'text-dorado'}`}>
        {script}
      </p>
    )
  }
  {
    eyebrow && (
      <p class={`eyebrow mt-3 ${tone === 'dark' ? 'text-tinta/50' : 'text-crema/60'}`}>{eyebrow}</p>
    )
  }
  <h2
    class:list={[
      'mt-3 font-display text-4xl leading-[1.02] font-medium md:text-6xl',
      tone === 'dark' ? 'text-tinta' : 'text-crema',
    ]}
  >
    {title}
  </h2>
  {
    intro && (
      <p
        class:list={[
          'mt-5 text-base leading-relaxed',
          tone === 'dark' ? 'text-tinta/70' : 'text-crema/75',
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
