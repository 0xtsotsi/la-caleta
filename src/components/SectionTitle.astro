---
interface Props {
  /** Alleen gebruiken als het een echte categorie noemt (dag, rubriek). */
  label?: string;
  title: string;
  intro?: string;
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2';
  id?: string;
}

const { label, title, intro, tone = 'light', as: Tag = 'h2', id } = Astro.props;
const dark = tone === 'dark';
---

<div class="max-w-2xl">
  {label && <p class:list={['label', dark ? 'text-cobre' : 'text-terracota']}>{label}</p>}
  <Tag id={id} class:list={['display-l', label && 'mt-3', dark ? 'text-crema' : 'text-tinta']}>
    {title}
  </Tag>
  {intro && <p class:list={['lede mt-5', dark ? 'text-crema-2' : 'text-tinta-2']}>{intro}</p>}
  <slot />
</div>
