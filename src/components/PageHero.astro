---
import type { ImageMetadata } from 'astro';
import ArchImage from './ArchImage.astro';

interface Props {
  label?: string;
  title: string;
  /** Tweede regel van de kop, cursief. */
  titleItalic?: string;
  intro?: string;
  image: ImageMetadata;
  imageAlt: string;
  position?: string;
}

const { label, title, titleItalic, intro, image, imageAlt, position } = Astro.props;
---

<section class="on-dark glow-host pt-28 pb-14 md:pt-36 md:pb-20">
  <div class="glow" data-glow aria-hidden="true"></div>
  <div class="shell grid items-end gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-14">
    <div class="max-w-2xl">
      {label && <p class="label text-cobre">{label}</p>}
      <h1 class:list={['display-l text-crema', label && 'mt-4']} data-lines>
        <span class="line"><span>{title}</span></span>
        {titleItalic && <span class="line"><span class="italic">{titleItalic}</span></span>}
      </h1>
      {intro && <p class="lede mt-6 max-w-xl text-crema-2">{intro}</p>}
      <slot />
    </div>
    <ArchImage
      image={image}
      alt={imageAlt}
      sizes="(min-width: 768px) 36vw, 88vw"
      aspect="aspect-[4/5] md:aspect-[3/4]"
      class="mx-auto w-full max-w-[22rem] md:max-w-none"
      loading="eager"
      position={position}
    />
  </div>
</section>
