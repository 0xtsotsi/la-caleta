---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  image: ImageMetadata;
  imageAlt: string;
  position?: string;
}

const { eyebrow, title, intro, image, imageAlt, position = 'center' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-rojo-oscuro">
  <Image
    src={image}
    alt={imageAlt}
    class="absolute inset-0 -z-10 h-full w-full object-cover opacity-45"
    widths={[768, 1280, 1920]}
    sizes="100vw"
    style={`object-position: ${position}`}
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-rojo-oscuro/80 via-rojo-oscuro/70 to-rojo-oscuro/95"></div>

  <div class="shell pt-36 pb-20 text-crema md:pt-44 md:pb-28">
    <div class="max-w-2xl">
      {
        eyebrow && (
          <p class="eyebrow text-crema/60">{eyebrow}</p>
        )
      }
      <h1 class="mt-4 font-display text-5xl leading-[1] font-medium md:text-7xl">{title}</h1>
      {
        intro && (
          <p class="mt-6 max-w-xl text-base leading-relaxed text-crema/80 md:text-lg">{intro}</p>
        )
      }
    </div>
  </div>
</section>
