---
import { openingHours } from '../data/site';

interface Props {
  tone?: 'light' | 'dark';
}

const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<dl class="text-[0.9375rem]" data-hours>
  {
    openingHours.map((day) => (
      <div
        class:list={[
          'flex items-baseline justify-between gap-4 border-b py-2.5',
          dark ? 'border-crema/15' : 'border-tinta/15',
        ]}
        data-day={day.index}
      >
        <dt class="flex items-center gap-2">
          {day.day}
          <span class="sr-only" data-today-label hidden>
            {' '}(vandaag)
          </span>
        </dt>
        <dd class:list={['tabular-nums', day.status === 'closed' && (dark ? 'text-crema-2' : 'text-tinta-2')]}>
          {day.status === 'closed' ? 'Gesloten' : `${day.opens} tot ${day.closes}`}
        </dd>
      </div>
    ))
  }
</dl>
