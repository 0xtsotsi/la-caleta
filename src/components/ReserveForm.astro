---
import { openingHours, reservation, site } from '../data/site';
import Icon from './Icon.astro';

const key = (import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '').trim();
const toMinutes = (time: string) => {
  const [h, m] = time.split(':').map(Number);
  return h * 60 + m;
};
const fmt = (minutes: number) =>
  `${String(Math.floor(minutes / 60)).padStart(2, '0')}:${String(minutes % 60).padStart(2, '0')}`;

// Alle sloten die op enige dag kunnen; reserve.ts verbergt wat op de gekozen dag niet kan.
const earliest = Math.min(
  ...openingHours.filter((d) => d.status === 'open').map((d) => toMinutes(d.opens)),
);
const last = toMinutes(reservation.kitchenCloses) - reservation.lastSlotOffset;
const slots: string[] = [];
for (let t = earliest; t <= last; t += reservation.slotStep) slots.push(fmt(t));
---

<form
  id="reserveer-form"
  class="reserve-form [color-scheme:dark]"
  action={key ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`}
  method="post"
  enctype={key ? undefined : 'text/plain'}
  novalidate
  data-reserve-form
  data-key={key || undefined}
>
  {key && <input type="hidden" name="access_key" value={key} />}
  <input type="hidden" name="subject" value="Reserveringsaanvraag via lacaleta.nl" />
  <input type="hidden" name="from_name" value="Website La Caleta" />
  <div class="hp" aria-hidden="true">
    <label for="botcheck">Laat dit veld leeg</label>
    <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
  </div>

  <div class="rounded-none border border-err-dark p-4 text-[0.9375rem]" role="alert" data-form-error hidden>
    <p class="flex items-center gap-2 font-medium text-crema">
      <Icon name="alert" class="text-err-dark" /> Uw aanvraag is niet verstuurd.
    </p>
    <p class="mt-1 text-crema-2" data-form-error-text>
      Er ging iets mis bij het versturen. Uw gegevens staan er nog. Probeer het opnieuw, of bel ons.
    </p>
    <p class="mt-2 text-crema-2">
      Bel <a class="link-text text-crema" href={site.phoneHref}>{site.phone}</a> of mail{' '}
      <a class="link-text text-crema" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
  </div>

  <fieldset class="step">
    <legend class="step-legend"><span class="step-num">1</span> Datum en gezelschap</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field">
        <label for="datum" class="field-label">Datum</label>
        <input id="datum" name="datum" type="date" required class="field-input" aria-describedby="datum-hint datum-error" />
        <p id="datum-hint" class="text-[0.875rem] text-crema-2">Maandag en dinsdag gesloten.</p>
        <p id="datum-error" class="field-error" data-error-for="datum" hidden></p>
      </div>
      <div class="field">
        <label for="personen" class="field-label">Aantal personen</label>
        <select id="personen" name="personen" class="field-input select" aria-describedby="personen-error">
          {
            Array.from({ length: reservation.maxGuests }, (_, i) => i + 1).map((n) => (
              <option value={n} selected={n === 2}>
                {n} {n === 1 ? 'persoon' : 'personen'}
              </option>
            ))
          }
          <option value="meer">Meer dan {reservation.maxGuests} personen</option>
        </select>
        <p id="personen-error" class="field-error" data-error-for="personen" hidden></p>
      </div>
    </div>
  </fieldset>

  <fieldset class="step" aria-describedby="tijd-hint tijd-error">
    <legend class="step-legend"><span class="step-num">2</span> Tijd</legend>
    <p id="tijd-hint" class="text-[0.9375rem] text-crema-2" data-slot-hint>
      Kies een tijd. De keuken sluit om {reservation.kitchenCloses}.
    </p>
    <div class="slots mt-4" data-slots>
      {
        slots.map((slot) => (
          <label class="slot" data-slot={slot}>
            <input type="radio" name="tijd" value={slot} required />
            <span>{slot}</span>
          </label>
        ))
      }
    </div>
    <p id="tijd-error" class="field-error mt-3" data-error-for="tijd" hidden></p>
  </fieldset>

  <fieldset class="step">
    <legend class="step-legend"><span class="step-num">3</span> Uw gegevens</legend>
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="field sm:col-span-2">
        <label for="naam" class="field-label">Naam</label>
        <input id="naam" name="naam" type="text" required autocomplete="name" class="field-input" aria-describedby="naam-error" />
        <p id="naam-error" class="field-error" data-error-for="naam" hidden></p>
      </div>
      <div class="field">
        <label for="telefoon" class="field-label">Telefoon</label>
        <input id="telefoon" name="telefoon" type="tel" required autocomplete="tel" inputmode="tel" class="field-input" aria-describedby="telefoon-error" />
        <p id="telefoon-error" class="field-error" data-error-for="telefoon" hidden></p>
      </div>
      <div class="field">
        <label for="email" class="field-label">E-mail</label>
        <input id="email" name="email" type="email" required autocomplete="email" class="field-input" aria-describedby="email-error" />
        <p id="email-error" class="field-error" data-error-for="email" hidden></p>
      </div>
      <div class="field sm:col-span-2">
        <label for="opmerking" class="field-label">Opmerking <span class="font-normal text-crema-2">(niet verplicht)</span></label>
        <textarea id="opmerking" name="opmerking" rows="3" class="field-input resize-y" placeholder="Allergie, kinderstoel, iets te vieren, paella vooraf bestellen"></textarea>
      </div>
    </div>
  </fieldset>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
    <button type="submit" class="btn btn-reserve" data-submit>
      <span class="spinner" data-spinner hidden><Icon name="loader" /></span>
      <span data-submit-label>{key ? 'Verstuur aanvraag' : 'Verstuur aanvraag per e-mail'}</span>
    </button>
    <a href={site.phoneHref} class="link-u inline-flex items-center gap-2 text-crema">
      <Icon name="phone" /> Of bel {site.phone}
    </a>
  </div>
  <p class="text-[0.875rem] text-crema-2">
    Dit is een aanvraag. U krijgt een bevestiging van ons per e-mail of telefoon.
  </p>
  <p class="sr-only" aria-live="polite" data-form-status></p>
</form>

<div class="success scroll-mt-28" data-form-success hidden tabindex="-1" role="status">
  <p class="flex items-center gap-2 text-cobre">
    <Icon name="check" size={22} /> <span class="label" data-success-label>Aanvraag verstuurd</span>
  </p>
  <h2 class="display-m mt-3 text-crema" data-success-title>Bedankt, we hebben uw aanvraag.</h2>
  <p class="mt-3 max-w-lg text-crema-2" data-success-text>
    We bevestigen uw reservering zo snel mogelijk per e-mail of telefoon.
  </p>
  <dl class="mt-6 grid max-w-lg grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-crema/15 pt-5 text-[0.9375rem]">
    <dt class="text-crema-2">Datum</dt><dd class="text-crema" data-sum="datum"></dd>
    <dt class="text-crema-2">Tijd</dt><dd class="text-crema" data-sum="tijd"></dd>
    <dt class="text-crema-2">Personen</dt><dd class="text-crema" data-sum="personen"></dd>
    <dt class="text-crema-2">Naam</dt><dd class="text-crema" data-sum="naam"></dd>
  </dl>
  <p class="mt-6 text-[0.9375rem] text-crema-2">
    Iets veranderen? Bel <a class="link-text text-crema" href={site.phoneHref}>{site.phone}</a>.
  </p>
  <button type="button" class="btn btn-line mt-6" data-form-reset>Nog een aanvraag doen</button>
</div>

<style>
  .reserve-form {
    display: grid;
    gap: 2.5rem;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .step {
    display: grid;
    gap: 1.25rem;
    border: 0;
    margin: 0;
    padding: 0;
  }

  .step-legend {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding: 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--color-crema);
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-cobre);
    border-radius: 999px 999px 0 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-cobre);
  }

  .slots {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.25rem, 1fr));
    gap: 0.5rem;
  }

  .slot {
    position: relative;
    display: block;
  }

  .slot input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .slot span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    border: 1px solid var(--color-line-dark);
    font-variant-numeric: tabular-nums;
    color: var(--color-crema);
    transition:
      background-color var(--duration-quick) ease,
      border-color var(--duration-quick) ease,
      color var(--duration-quick) ease;
  }

  .slot:hover span {
    border-color: var(--color-crema-2);
  }

  .slot input:checked + span {
    background-color: var(--color-cobre);
    border-color: var(--color-cobre);
    color: var(--color-espresso);
    font-weight: 500;
  }

  .slot input:focus-visible + span {
    outline: 2px solid var(--color-cobre);
    outline-offset: 3px;
  }

  .slot[data-hidden='true'] {
    display: none;
  }

  .spinner {
    display: inline-flex;
    animation: spin 0.9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .success:focus {
    outline: none;
  }
</style>

<script>
  import '../scripts/reserve.ts';
</script>
