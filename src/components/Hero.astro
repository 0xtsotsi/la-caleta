---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-interieur.jpg';

const facts = [
  { label: 'Tapas dag', value: 'wo & do' },
  { label: 'Verse Spaanse wijnen', value: 'vanaf €21' },
  { label: 'Parkeren', value: 'gratis' },
];
---

<section class="hero relative isolate overflow-hidden bg-carbon">
  <div class="hero__photo">
    <Image
      src={heroImage}
      alt="Gasten aan tafel in het restaurant La Caleta, met de rode gordijnen en de volle zaal"
      class="h-full w-full object-cover"
      widths={[768, 1280, 1800]}
      sizes="(min-width: 1024px) 56vw, 100vw"
      loading="eager"
      quality={82}
      data-parallax
    />
  </div>
  <div class="hero__scrim"></div>
  <div class="kaarslicht absolute inset-0 -z-10"></div>

  <div class="shell relative flex min-h-[92svh] flex-col justify-end pt-40 pb-10 text-crema md:pb-14">
    <div class="max-w-xl lg:max-w-[38rem]">
      <p class="font-script text-3xl text-dorado-licht md:text-4xl" data-reveal>Bienvenido</p>
      <h1
        class="mt-3 font-display text-[3.1rem] leading-[0.95] font-medium sm:text-7xl lg:text-[5.2rem]"
        data-reveal
        data-reveal-delay="90"
      >
        Cocina de España<br />en tu mesa
      </h1>
      <p
        class="mt-6 max-w-lg text-base leading-relaxed text-crema/85 md:text-lg"
        data-reveal
        data-reveal-delay="180"
      >
        Tapas, grill en verse vis in het hart van Rozenburg. Al meer dan zeventien jaar serveren wij
        Spaanse gerechten met passie, bereid in olijfolie en met vlees van het beste.
      </p>

      <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="260">
        <a href="/contact/#reserveren" class="btn btn-rojo">Reserveer een tafel</a>
        <a href="/menu/" class="btn btn-line">Bekijk het menu</a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-6 border-t border-crema/20 pt-6 text-[0.68rem] tracking-[0.2em] uppercase sm:flex-row sm:items-center sm:justify-between"
      data-reveal
      data-reveal-delay="340"
    >
      <ul class="flex flex-wrap gap-x-10 gap-y-3 text-crema/70">
        {
          facts.map((fact) => (
            <li>
              <span class="text-crema">{fact.value}</span> · {fact.label}
            </li>
          ))
        }
      </ul>

      <a
        href="#intro"
        class="hidden items-center gap-3 text-crema/60 transition-colors hover:text-crema sm:flex"
        aria-label="Scroll naar de introductie"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-crema/40">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M6 1v10M2 7l4 4 4-4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
        Scroll
      </a>
    </div>
  </div>
</section>

<style>
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -10;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -10;
    background:
      linear-gradient(
        to top,
        rgba(20, 13, 8, 0.96) 0%,
        rgba(20, 13, 8, 0.72) 34%,
        rgba(20, 13, 8, 0.42) 68%,
        rgba(20, 13, 8, 0.62) 100%
      );
  }

  @media (min-width: 1024px) {
    .hero__photo {
      left: 42%;
    }

    .hero__scrim {
      background:
        linear-gradient(
          to right,
          rgba(20, 13, 8, 0.97) 0%,
          rgba(20, 13, 8, 0.9) 26%,
          rgba(20, 13, 8, 0.52) 48%,
          rgba(20, 13, 8, 0.04) 78%,
          rgba(20, 13, 8, 0.28) 100%
        ),
        linear-gradient(
          to bottom,
          rgba(20, 13, 8, 0.82) 0%,
          rgba(20, 13, 8, 0.42) 14%,
          rgba(20, 13, 8, 0) 40%
        ),
        linear-gradient(to top, rgba(20, 13, 8, 0.88) 0%, rgba(20, 13, 8, 0) 42%);
    }
  }
</style>
