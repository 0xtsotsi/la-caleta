---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-tapas.jpg';
import { withBase } from '../lib/urls';

const facts = [
  { label: 'Tapas dag', value: 'wo & do' },
  { label: 'Verse Spaanse wijnen', value: 'vanaf €21' },
  { label: 'Parkeren', value: 'gratis' },
];
---

<section class="hero relative isolate overflow-hidden bg-carbon">
  <div class="hero__photo">
    <Image
      src={heroImage}
      alt="Een tafel vol Spaanse tapas: gambas, chorizo, olijven, kaas en croquettes in terracotta schalen"
      class="h-full w-full object-cover"
      widths={[768, 1280, 2200]}
      sizes="100vw"
      loading="eager"
      quality={84}
      data-parallax
    />
  </div>
  <div class="hero__scrim"></div>
  <div class="kaarslicht absolute inset-0 -z-10"></div>

  <div class="shell relative flex min-h-[92svh] flex-col justify-end pt-40 pb-10 text-crema md:pb-14">
    <div class="max-w-xl lg:max-w-[36rem]">
      <p class="font-script text-3xl text-dorado-licht md:text-4xl" data-reveal>Bienvenido</p>
      <h1
        class="mt-3 font-display text-[3.1rem] leading-[0.95] font-medium sm:text-7xl lg:text-[5.2rem]"
        data-reveal
        data-reveal-delay="90"
      >
        Cocina de España<br />en tu mesa
      </h1>
      <p
        class="mt-6 max-w-lg text-base leading-relaxed text-crema/90 md:text-lg"
        data-reveal
        data-reveal-delay="180"
      >
        Tapas, grill en verse vis in het hart van Rozenburg. Al meer dan zeventien jaar serveren wij
        Spaanse gerechten met passie, bereid in olijfolie en met vlees van het beste.
      </p>

      <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="260">
        <a href={withBase('/contact/#reserveren')} class="btn btn-rojo">Reserveer een tafel</a>
        <a href={withBase('/menu/')} class="btn btn-line">Bekijk het menu</a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-6 border-t border-crema/25 pt-6 text-[0.68rem] tracking-[0.2em] uppercase sm:flex-row sm:items-center sm:justify-between"
      data-reveal
      data-reveal-delay="340"
    >
      <ul class="flex flex-wrap gap-x-10 gap-y-3 text-crema/80">
        {
          facts.map((fact) => (
            <li>
              <span class="text-crema">{fact.value}</span> · {fact.label}
            </li>
          ))
        }
      </ul>

      <a
        href="#intro"
        class="hidden items-center gap-3 text-crema/70 transition-colors hover:text-crema sm:flex"
        aria-label="Scroll naar de introductie"
      >
        <span class="flex h-9 w-9 items-center justify-center rounded-full border border-crema/50">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M6 1v10M2 7l4 4 4-4" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
        Scroll
      </a>
    </div>
  </div>
</section>

<style>
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -10;
  }

  /* Links donker voor de tekst, rechts het eten helder zichtbaar */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -10;
    background:
      linear-gradient(
        to right,
        rgba(20, 13, 8, 0.94) 0%,
        rgba(20, 13, 8, 0.74) 34%,
        rgba(20, 13, 8, 0.28) 62%,
        rgba(20, 13, 8, 0.12) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(20, 13, 8, 0.72) 0%,
        rgba(20, 13, 8, 0.14) 34%,
        rgba(20, 13, 8, 0) 62%
      ),
      linear-gradient(to top, rgba(20, 13, 8, 0.92) 0%, rgba(20, 13, 8, 0) 46%);
  }

  @media (max-width: 1023px) {
    .hero__photo {
      top: -6%;
    }

    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(20, 13, 8, 0.95) 0%,
          rgba(20, 13, 8, 0.78) 32%,
          rgba(20, 13, 8, 0.34) 62%,
          rgba(20, 13, 8, 0.55) 100%
        );
    }
  }
</style>
