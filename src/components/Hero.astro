---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/stock-hero-bar.jpg';
import { tapasDay } from '../data/site';
import { withBase } from '../lib/urls';
---

<section class="hero on-dark" data-hero aria-labelledby="hero-title">
  <div class="hero-copy shell" data-hero-copy>
    <div class="max-w-[34rem]">
      <p class="label text-cobre">Raadhuisplein 4a, Rozenburg</p>
      <h1 id="hero-title" class="display-xl mt-5 text-crema" data-lines>
        <span class="line"><span>Cocina de España</span></span>
        <span class="line"><span class="italic">en tu mesa</span></span>
      </h1>
      <p class="lede mt-6 max-w-md text-crema-2">
        Tapas, vlees van de grill, vis en paella. Van vader op dochter overgegaan, met dezelfde
        keuken en hetzelfde team.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/reserveren/')} class="btn btn-reserve">Reserveer een tafel</a>
        <a href={withBase('/menu/')} class="btn btn-line">Bekijk de kaart</a>
      </div>
      <dl class="mt-10 grid gap-4 border-t border-crema/15 pt-6 text-[0.9375rem] sm:grid-cols-2">
        <div>
          <dt class="text-crema-2">Vandaag</dt>
          <dd class="mt-0.5 flex items-center gap-2 text-crema">
            <span class="open-dot" data-open-dot aria-hidden="true"></span>
            <span data-open-today>Wo t/m za vanaf 11:00, zo vanaf 16:00</span>
          </dd>
        </div>
        <div>
          <dt class="text-crema-2">Tapasdag</dt>
          <dd class="mt-0.5 text-crema">Wo en do, {tapasDay.price} p.p.</dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="hero-media" data-hero-media>
    <Image
      src={heroPhoto}
      alt="Tapas op de toonbank van een Spaanse bar, met hangende wijnglazen er boven"
      widths={[640, 1024, 1600, 2400]}
      sizes="(min-width: 768px) 100vw, 90vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
      data-hero-img
    />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 7rem;
    padding-bottom: 3rem;
  }

  .hero-media {
    position: relative;
    margin: 2.5rem 1.25rem 0;
    aspect-ratio: 4 / 5;
    clip-path: inset(0% 0% 0% 0% round 999px 999px 0px 0px);
    background-color: var(--color-espresso-2);
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .hero-media {
      margin-inline: 2.5rem;
      aspect-ratio: 3 / 2;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: max(100svh, 40rem);
      padding-bottom: 4rem;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
    }

    .hero-media {
      position: absolute;
      inset: 0;
      margin: 0;
      aspect-ratio: auto;
      clip-path: inset(16% 5% 0% 52% round 999px 999px 0px 0px);
      z-index: 1;
    }
  }
</style>
