---
import { site } from '../data/site';
import { withBase } from '../lib/urls';
import Icon from './Icon.astro';

interface Props {
  hide?: boolean;
}

const { hide = false } = Astro.props;
---

{
  !hide && (
    <div id="mobile-bar" class="on-dark fixed inset-x-0 bottom-0 z-40 border-t border-crema/15 lg:hidden">
      <div class="grid grid-cols-2">
        <a
          href={site.phoneHref}
          class="flex min-h-16 items-center justify-center gap-2 text-[0.9375rem] font-medium text-crema"
        >
          <Icon name="phone" /> Bel
        </a>
        <a
          href={withBase('/reserveren/')}
          class="btn-reserve flex min-h-16 items-center justify-center gap-2 text-[0.9375rem] font-medium"
        >
          <Icon name="calendar" /> Reserveer
        </a>
      </div>
    </div>
  )
}

<style>
  #mobile-bar {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
</style>
