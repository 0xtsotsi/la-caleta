---
import { navItems, site } from '../data/site';
import { withBase } from '../lib/urls';
import Icon from './Icon.astro';
import OpeningHours from './OpeningHours.astro';
---

<footer class="on-dark">
  <div class="azulejo" aria-hidden="true"></div>
  <div class="shell grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1fr] lg:gap-10">
    <div>
      <p class="font-script text-5xl leading-none text-crema">La Caleta</p>
      <p class="mt-5 max-w-xs text-[0.9375rem] text-crema-2">
        Spaanse tapas, vlees van de grill, vis en paella aan het Raadhuisplein in Rozenburg.
      </p>
      <ul class="mt-6 space-y-2 text-[0.9375rem]">
        <li class="flex items-center gap-2.5 text-crema-2">
          <Icon name="car" class="text-cobre" /> Gratis parkeren
        </li>
        <li class="flex items-center gap-2.5 text-crema-2">
          <Icon name="gift" class="text-cobre" /> VVV-cadeaukaart welkom
        </li>
      </ul>
    </div>

    <nav id="footer-nav" aria-label="Footermenu">
      <h2 class="label text-cobre">Pagina's</h2>
      <ul class="mt-5 space-y-2 text-[0.9375rem]">
        {
          navItems.map((item) => (
            <li>
              <a href={withBase(item.href)} class="link-u text-crema">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="label text-cobre">Openingstijden</h2>
      <div class="mt-4">
        <OpeningHours tone="dark" />
      </div>
    </div>

    <div>
      <h2 class="label text-cobre">Contact</h2>
      <address class="mt-5 space-y-1 text-[0.9375rem] not-italic text-crema-2">
        <p class="text-crema">{site.legalName}</p>
        <p>{site.address.street}</p>
        <p>{site.address.postalCode} {site.address.city}</p>
      </address>
      <ul class="mt-5 space-y-2 text-[0.9375rem]">
        <li><a href={site.phoneHref} class="link-u text-crema">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="link-u text-crema">{site.email}</a></li>
        <li>
          <a href={site.social.instagram} class="link-u text-crema" rel="noopener noreferrer" target="_blank">
            Instagram<span class="sr-only"> (opent in een nieuw venster)</span>
          </a>
        </li>
        <li>
          <a href={site.social.facebook} class="link-u text-crema" rel="noopener noreferrer" target="_blank">
            Facebook<span class="sr-only"> (opent in een nieuw venster)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-crema/10">
    <div class="shell flex flex-col gap-1 py-5 text-[0.875rem] text-crema-2 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} {site.legalName}</p>
      <p lang="es">Cocina de España en tu mesa</p>
    </div>
  </div>
</footer>
