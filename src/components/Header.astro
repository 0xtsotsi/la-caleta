---
import { navItems, site } from '../data/site';
import { withBase } from '../lib/urls';
import Icon from './Icon.astro';

interface Props {
  transparent?: boolean;
  currentPath: string;
}

const { transparent = true, currentPath } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

const mainLinks = navItems.filter((item) => item.href !== '/' && item.href !== '/reserveren/');
---

<header
  id="site-header"
  data-solid={transparent ? 'false' : 'true'}
  class="on-dark fixed inset-x-0 top-0 z-50"
>
  <div class="shell flex h-18 items-center justify-between gap-6 md:h-20">
    <a href={withBase('/')} class="flex flex-col leading-none" aria-label={`${site.legalName}, naar de homepage`}>
      <span class="font-script text-[2.1rem] leading-none text-crema md:text-[2.4rem]">La Caleta</span>
      <span class="mt-0.5 text-[0.8125rem] text-crema-2">Spaans restaurant in Rozenburg</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Hoofdmenu">
      {
        mainLinks.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="link-u py-1 text-[0.9375rem] text-crema"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <p class="hidden items-center gap-2 text-[0.875rem] text-crema-2 xl:flex">
        <span class="open-dot" data-open-dot aria-hidden="true"></span>
        <span data-open-today>Wo t/m za vanaf 11:00, zo vanaf 16:00</span>
      </p>
      <a
        href={withBase('/reserveren/')}
        class="btn btn-reserve hidden sm:inline-flex"
        aria-current={isActive('/reserveren/') ? 'page' : undefined}
      >
        Reserveer
      </a>
      <button
        type="button"
        class="js-only flex h-11 w-11 items-center justify-center text-crema lg:hidden"
        aria-haspopup="dialog"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-open
      >
        <Icon name="menu" size={24} />
        <span class="sr-only">Menu openen</span>
      </button>
      <a href="#footer-nav" class="nojs-only text-crema lg:hidden">Menu</a>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu on-dark" aria-label="Menu">
  <div class="shell flex min-h-full flex-col py-5">
    <div class="flex items-center justify-between">
      <span class="font-script text-[2.1rem] leading-none text-crema">La Caleta</span>
      <button
        type="button"
        class="flex h-11 w-11 items-center justify-center text-crema"
        data-menu-close
      >
        <Icon name="x" size={26} />
        <span class="sr-only">Menu sluiten</span>
      </button>
    </div>
    <nav class="mt-8 flex flex-col" aria-label="Mobiel menu">
      {
        navItems.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="border-b border-crema/15 py-3.5 font-display text-[2rem] leading-tight text-crema aria-[current=page]:text-cobre"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="mt-auto space-y-2 pt-10 text-[0.9375rem] text-crema-2">
      <p>{site.address.street}, {site.address.city}</p>
      <a href={site.phoneHref} class="link-text block text-crema">Bel {site.phone}</a>
    </div>
  </div>
</dialog>

<style>
  /* Altijd donker: ook als de boog in de hero opent blijft het menu leesbaar. */
  #site-header {
    background-color: var(--color-espresso);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-base) ease;
  }

  #site-header[data-solid='true'] {
    border-bottom-color: oklch(0.968 0.014 85 / 0.1);
  }

  .mobile-menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .mobile-menu::backdrop {
    background: var(--color-espresso);
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const transparent = header?.dataset.solid === 'false';
  const setSolid = () => {
    if (!header || !transparent) return;
    header.dataset.solid = String(window.scrollY > 24);
  };
  setSolid();
  window.addEventListener('scroll', setSolid, { passive: true });

  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  openButton?.addEventListener('click', () => {
    dialog?.showModal();
    openButton.setAttribute('aria-expanded', 'true');
  });
  closeButton?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('close', () => {
    openButton?.setAttribute('aria-expanded', 'false');
    openButton?.focus();
  });
  dialog?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => dialog.close());
  });
</script>
