---
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/dancing-script/400.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, jsonLd } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Zet op false voor pagina's zonder volledig-bleed hero. */
  transparentHeader?: boolean;
  image?: string;
}

const {
  title,
  description = site.description,
  transparentHeader = true,
  image = '/og.jpg',
} = Astro.props;

const pageTitle = title ? `${title} · ${site.legalName}` : `${site.legalName} · ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImage = new URL(image, Astro.site ?? site.url).toString();
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#a4161a" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen bg-crema text-tinta antialiased">
    <a
      href="#hoofdinhoud"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-rojo focus:px-5 focus:py-3 focus:text-crema"
    >
      Direct naar de inhoud
    </a>

    <Header transparent={transparentHeader} currentPath={Astro.url.pathname} />

    <main id="hoofdinhoud">
      <slot />
    </main>

    <Footer />
  </body>
</html>
