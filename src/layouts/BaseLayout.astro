---
import '../styles/global.css';

import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/dancing-script/400.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MobileBar from '../components/MobileBar.astro';
import { restaurantJsonLd, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** false voor pagina's zonder beeldvullende hero: de header is dan meteen donker. */
  transparentHeader?: boolean;
  image?: string;
  /** Pagina zonder site-navigatie en buiten zoekmachines, bijvoorbeeld een klantpresentatie. */
  bare?: boolean;
}

const {
  title,
  description = site.description,
  transparentHeader = true,
  image = '/og.jpg',
  bare = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pageTitle = title
  ? `${title} | ${site.legalName} Rozenburg`
  : `${site.legalName} Rozenburg | Spaanse tapas, grill en paella`;
const baseUrl = new URL(base, Astro.site ?? site.url).toString();
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImage = new URL(image.replace(/^\//, ''), baseUrl).toString();
const path = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {bare && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />

    <meta property="og:type" content="restaurant.restaurant" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1d140f" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(restaurantJsonLd(baseUrl))}
    />
  </head>
  <body
    class:list={['min-h-screen', !bare && 'pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0']}
  >
    <a
      href="#hoofdinhoud"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-crema focus:px-5 focus:py-3 focus:text-tinta"
    >
      Direct naar de inhoud
    </a>

    {!bare && <Header transparent={transparentHeader} currentPath={path} />}

    <main id="hoofdinhoud" tabindex="-1">
      <slot />
    </main>

    {!bare && <Footer />}

    {!bare && <MobileBar hide={path.startsWith('/reserveren')} />}

    <script>
      import '../scripts/open-today.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
